<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Patch the standard "Customers" window action so that
        contacts flagged as is_cash_customer_contact are hidden
        from the Customers list in Sales / Invoicing / Contacts.

        We target 'contacts.action_contacts' (Odoo 17/18/19 CE).
        The domain adds one extra filter: is_cash_customer_contact = False.
    -->

    <!-- Sales > Customers action -->
    <record id="action_patch_sales_customers" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('customer_rank', '&gt;', 0), ('is_cash_customer_contact', '=', False)]</field>
        <field name="context">{'default_customer_rank': 1}</field>
    </record>

    <!-- Override the Contacts app customer filter search -->
    <record id="view_res_partner_filter_inherit_pcb" model="ir.ui.view">
        <field name="name">res.partner.search.pcb</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <filter name="customer" position="attributes">
                <attribute name="domain">[('customer_rank', '&gt;', 0), ('is_cash_customer_contact', '=', False)]</attribute>
            </filter>
        </field>
    </record>

</odoo>