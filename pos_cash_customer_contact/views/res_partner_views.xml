<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Add Gender field to Contact form view -->
    <record id="view_partner_form_inherit_gender" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.gender</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='function']" position="after">
                <field name="x_gender" widget="selection"/>
            </xpath>
        </field>
    </record>

    <!-- Add Gender field to Contact tree/list view for easy filtering -->
    <record id="view_partner_tree_inherit_gender" model="ir.ui.view">
        <field name="name">res.partner.tree.inherit.gender</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="x_gender" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Add Gender to search view for filtering -->
    <record id="view_partner_search_inherit_gender" model="ir.ui.view">
        <field name="name">res.partner.search.inherit.gender</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='type_company']" position="after">
                <separator/>
                <filter name="gender_male" string="Male" domain="[('x_gender', '=', 'male')]"/>
                <filter name="gender_female" string="Female" domain="[('x_gender', '=', 'female')]"/>
            </xpath>
        </field>
    </record>

</odoo>
