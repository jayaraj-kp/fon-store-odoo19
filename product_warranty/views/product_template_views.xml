<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_warranty_form_view" model="ir.ui.view">
        <field name="name">product.template.warranty.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Warranty" name="warranty_page">
                    <group>
                        <field name="warranty_months" placeholder="e.g. 6"/>
                    </group>
                    <p class="text-muted" invisible="warranty_months == 0">
                        Each unit sold (tracked by serial number) will be
                        covered for this many months, starting from its
                        sale/POS order date.
                    </p>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
