<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════════
             Wizard Form View
             ═══════════════════════════════════════════════════════════ -->
        <record id="product_import_export_wizard_form" model="ir.ui.view">
            <field name="name">product.import.export.wizard.form</field>
            <field name="model">product.import.export.wizard</field>
            <field name="arch" type="xml">
                <form string="Product Import / Export">

                    <sheet>
                        <div class="oe_title">
                            <h1>Product Import / Export</h1>
                            <p class="text-muted">
                                Includes: Internal Reference · Name · Model · Sales Price ·
                                Cost · <strong>MRP Price</strong> · Category · Barcode
                            </p>
                        </div>

                        <group>
                            <field name="mode" widget="radio" options="{'horizontal': true}"/>
                        </group>

                        <!-- EXPORT section -->
                        <group invisible="mode != 'export'">
                            <group string="Export">
                                <field name="export_file"
                                       widget="binary"
                                       filename="export_filename"
                                       invisible="not export_file"/>
                                <field name="export_filename" invisible="1"/>
                            </group>
                        </group>

                        <!-- IMPORT section -->
                        <group invisible="mode != 'import'">
                            <group string="Upload File">
                                <field name="import_file"
                                       widget="binary"
                                       filename="import_filename"
                                       string="Upload Excel (.xlsx)"/>
                                <field name="import_filename" invisible="1"/>
                            </group>
                            <group string="Result" invisible="not import_result">
                                <field name="import_result" nolabel="1"/>
                            </group>
                        </group>

                        <!-- Download template hint -->
                        <div class="alert alert-info" invisible="mode != 'import'">
                            <strong>Tip:</strong> Use the <em>Download Template</em> button
                            below to get a pre-formatted Excel file with the correct columns.
                            Import will <strong>create</strong> new products or
                            <strong>update</strong> existing ones (matched by
                            Internal Reference or Product Name).
                        </div>

                    </sheet>

                    <footer>
                        <!-- Export button -->
                        <button name="action_export"
                                string="Export to Excel"
                                type="object"
                                class="btn-primary"
                                invisible="mode != 'export'"/>

                        <!-- Import buttons -->
                        <button name="action_download_template"
                                string="Download Template"
                                type="object"
                                class="btn-secondary"
                                invisible="mode != 'import'"/>
                        <button name="action_import"
                                string="Import"
                                type="object"
                                class="btn-primary"
                                invisible="mode != 'import'"/>

                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>

                </form>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             Menu Action – opens the wizard
             ═══════════════════════════════════════════════════════════ -->
        <record id="action_product_import_export_wizard" model="ir.actions.act_window">
            <field name="name">Import / Export Products</field>
            <field name="res_model">product.import.export.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Add entry under Inventory › Products menu -->
        <menuitem
            id="menu_product_import_export"
            name="Import / Export Products"
            parent="stock.menu_product_in_config"
            action="action_product_import_export_wizard"
            sequence="99"/>

    </data>
</odoo>
