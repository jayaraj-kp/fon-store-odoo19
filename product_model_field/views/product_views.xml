<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════════
             PRODUCT TEMPLATE – Form View
             ═══════════════════════════════════════════════════════════ -->
        <record id="product_template_form_view_model" model="ir.ui.view">
            <field name="name">product.template.form.model</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">

                <!-- MRP Price directly below Sales Price -->
                <xpath expr="//group[@name='group_standard_price']/div[@name='list_price_uom']" position="after">
                    <label for="mrp_price" string="MRP Price"/>
                    <div name="mrp_price_div">
                        <field name="mrp_price"
                               class="oe_inline"
                               widget="monetary"
                               options="{'currency_field': 'currency_id', 'field_digits': True}"
                               nolabel="1"/>
                    </div>
                </xpath>

                <!--
                    REMOVED: readonly="not user_has_groups('base.group_erp_manager')"
                    Reason:  user_has_groups() is a Python method, not a model field.
                             Odoo 19 strictly validates that all names used in view
                             attribute expressions exist as fields on the model.
                             Using user_has_groups() here causes a ParseError on install.

                    ALTERNATIVE: If you need to restrict editing of list_price to
                    ERP managers only, use the 'groups' attribute on the field so
                    that non-managers see it as read-only:

                    <xpath expr="//group[@name='group_standard_price']/div[@name='list_price_uom']/field[@name='list_price']" position="attributes">
                        <attribute name="groups">base.group_erp_manager</attribute>
                    </xpath>

                    Note: 'groups' makes the field invisible (not just readonly) for
                    users outside the group. If you need it visible-but-readonly for
                    all users, add a computed Boolean field (e.g. is_erp_manager) to
                    the model and reference that field in the readonly expression.
                -->

                <!-- Model after Category -->
                <xpath expr="//group[@name='group_standard_price']/field[@name='categ_id']" position="after">
                    <field name="model_number"
                           string="Model"
                           placeholder="e.g., IP14PM"/>
                </xpath>

            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             PRODUCT VARIANT – Form View
             ═══════════════════════════════════════════════════════════ -->
        <record id="product_product_form_view_model" model="ir.ui.view">
            <field name="name">product.product.form.model</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='barcode']" position="after">
                    <field name="model_number"
                           string="Model"
                           placeholder="e.g., IP14PM"/>
                    <field name="mrp_price"
                           string="MRP Price"
                           widget="monetary"
                           options="{'currency_field': 'currency_id'}"/>
                </xpath>

            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             PRODUCT TEMPLATE – List / Tree View
             ═══════════════════════════════════════════════════════════ -->
        <record id="product_template_tree_view_model" model="ir.ui.view">
            <field name="name">product.template.tree.model</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='list_price']" position="after">
                    <field name="mrp_price" optional="show" string="MRP Price"/>
                    <field name="model_number" optional="show" string="Model"/>
                </xpath>

            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             PRODUCT TEMPLATE – Search View
             ═══════════════════════════════════════════════════════════ -->
        <record id="product_template_search_view_model" model="ir.ui.view">
            <field name="name">product.template.search.model</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_search_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='name']" position="after">
                    <field name="model_number" string="Model"/>
                    <field name="mrp_price"    string="MRP Price"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>