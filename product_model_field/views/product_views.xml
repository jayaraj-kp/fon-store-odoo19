<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════════
             PRODUCT TEMPLATE – Form View
             Adds: Model field (after categ_id) + MRP Price (after Model)
             ═══════════════════════════════════════════════════════════ -->
        <record id="product_template_form_view_model" model="ir.ui.view">
            <field name="name">product.template.form.model</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">

                <!-- Model field after Category -->
                <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="model_number" placeholder="e.g., IP14PM"/>
                    <field name="mrp_price" widget="monetary"
                           options="{'currency_field': 'currency_id'}"/>
                </xpath>

            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             PRODUCT VARIANT – Form View
             Adds: Model field (after barcode) + MRP Price (after Model)
             ═══════════════════════════════════════════════════════════ -->
        <record id="product_product_form_view_model" model="ir.ui.view">
            <field name="name">product.product.form.model</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='barcode']" position="after">
                    <field name="model_number" placeholder="e.g., IP14PM"/>
                    <field name="mrp_price" widget="monetary"
                           options="{'currency_field': 'currency_id'}"/>
                </xpath>

            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             PRODUCT TEMPLATE – List / Tree View
             Shows Model + MRP Price columns in the product list
             ═══════════════════════════════════════════════════════════ -->
        <record id="product_template_tree_view_model" model="ir.ui.view">
            <field name="name">product.template.tree.model</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='list_price']" position="after">
                    <field name="mrp_price" optional="show" string="MRP Price"/>
                    <field name="model_number" optional="show" string="Model"/>
                </xpath>

            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             PRODUCT TEMPLATE – Search View
             Adds MRP Price and Model as searchable / filterable fields
             ═══════════════════════════════════════════════════════════ -->
        <record id="product_template_search_view_model" model="ir.ui.view">
            <field name="name">product.template.search.model</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_search_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='name']" position="after">
                    <field name="model_number" string="Model"/>
                    <field name="mrp_price"    string="MRP Price"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
