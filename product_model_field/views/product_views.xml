<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════════
             PRODUCT TEMPLATE – Form View
             ═══════════════════════════════════════════════════════════ -->
        <record id="product_template_form_view_model" model="ir.ui.view">
            <field name="name">product.template.form.model</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">

                <!-- MRP Price directly below Sales Price — uses original working xpath -->
                <xpath expr="//group[@name='group_standard_price']/div[@name='list_price_uom']" position="after">
                    <label for="mrp_price" string="MRP Price"/>
                    <div name="mrp_price_div">
                        <field name="mrp_price"
                               class="oe_inline"
                               widget="monetary"
                               options="{'currency_field': 'currency_id', 'field_digits': True}"
                               nolabel="1"/>
                    </div>
                </xpath>

                <!-- Model after Category -->
                <xpath expr="//group[@name='group_standard_price']/field[@name='categ_id']" position="after">
                    <field name="model_number"
                           string="Model"
                           placeholder="e.g., IP14PM"/>
                </xpath>

            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             PRODUCT TEMPLATE – List / Tree View
             ═══════════════════════════════════════════════════════════ -->
        <record id="product_template_tree_view_model" model="ir.ui.view">
            <field name="name">product.template.tree.model</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='list_price']" position="after">
                    <field name="mrp_price" optional="show" string="MRP Price"/>
                    <field name="model_number" optional="show" string="Model"/>
                </xpath>

            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             PRODUCT TEMPLATE – Search View
             model_number is on product.template — safe here
             ═══════════════════════════════════════════════════════════ -->
        <record id="product_template_search_view_model" model="ir.ui.view">
            <field name="name">product.template.search.model</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_search_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='name']" position="after">
                    <field name="model_number" string="Model"/>
                    <field name="mrp_price" string="MRP Price"/>
                </xpath>

            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             PRODUCT PRODUCT – Search View
             FIX: model_number does NOT exist on product.product —
             use filter_domain through the template relation instead.
             This was the root cause of the original "Unknown field" error.
             ═══════════════════════════════════════════════════════════ -->
        <record id="product_product_search_view_model" model="ir.ui.view">
            <field name="name">product.product.search.model</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_search_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='name']" position="after">
                    <field name="name"
                           string="Model"
                           filter_domain="[('product_tmpl_id.model_number', 'ilike', self)]"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>


