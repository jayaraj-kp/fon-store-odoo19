<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         product.template form view — add Model & MRP Price fields
         ══════════════════════════════════════════════════════════════════ -->
    <record id="view_product_template_form_mrp" model="ir.ui.view">
        <field name="name">product.template.form.mrp.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Place MRP Price right after Sales Price -->
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="mrp_price"/>
            </xpath>
            <!-- Place Model after Internal Reference (default_code always exists in Odoo 19) -->
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="model_number"
                       placeholder="e.g. IP14PM"
                       help="Alphanumeric model number/identifier"/>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         product.template list/tree view — optional columns
         ══════════════════════════════════════════════════════════════════ -->
    <record id="view_product_template_tree_mrp" model="ir.ui.view">
        <field name="name">product.template.tree.mrp.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="mrp_price" optional="show"/>
                <field name="model_number" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         product.template search view
         FIX: model_number belongs to product.template — safe to search here
         ══════════════════════════════════════════════════════════════════ -->
    <record id="view_product_template_search_mrp" model="ir.ui.view">
        <field name="name">product.template.search.mrp.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="model_number" string="Model"/>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         product.product search view  ← THE FIX IS HERE
         model_number does NOT exist on product.product directly.
         We search via the template relation using a filter_domain.
         ══════════════════════════════════════════════════════════════════ -->
    <record id="view_product_product_search_mrp" model="ir.ui.view">
        <field name="name">product.product.search.mrp.price</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <!-- Use filter_domain so Odoo resolves through the template -->
                <field name="name"
                       string="Model"
                       filter_domain="[('product_tmpl_id.model_number', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>

</odoo>
