<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Product field restrictions are enforced at TWO reliable layers:
          1. Python ORM  — product_template.py overrides read() and write()
          2. JavaScript  — access_restrictions.js hides DOM elements after render

        XML view inheritance is intentionally minimal here to avoid XPath errors
        caused by fields that may not exist in every Odoo 19 CE view configuration.
        The JS layer handles all UI hiding reliably.
    -->
</odoo>
