<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Adds the 'Rack' column to the Order Lines tab of the
        Sale Order / Quotation form view.
        The field is a Many2one to stock.location filtered to internal locations.
    -->
    <record id="view_sale_order_line_rack_inherit" model="ir.ui.view">
        <field name="name">sale.order.line.rack.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']"
                   position="after">
                <field name="rack"
                       string="Rack"
                       optional="show"
                       options="{'no_create': True, 'no_quick_create': True}"
                       domain="[('usage', '=', 'internal')]"/>
            </xpath>

        </field>
    </record>

</odoo>
