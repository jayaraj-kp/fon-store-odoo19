<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="custom_due_reports.DueReportView">
        <div t-attf-class="o_due_report_container {{ state.theme === 'dark' ? 'o_dark_theme' : 'o_light_theme' }}">

            <!-- Top Control Bar / Filter Header -->
            <div class="o_due_report_header_bar border-bottom shadow-sm p-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                    <!-- Left: Report Type & Due Filters -->
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <div class="btn-group" role="group">
                            <button type="button"
                                    t-attf-class="btn btn-sm {{ state.move_type === 'out_invoice' ? 'btn-primary' : 'btn-outline-primary' }}"
                                    t-on-click="() => this.setMoveType('out_invoice')">
                                <i class="fa fa-users me-1"/> Customer Due Report
                            </button>
                            <button type="button"
                                    t-attf-class="btn btn-sm {{ state.move_type === 'in_invoice' ? 'btn-primary' : 'btn-outline-primary' }}"
                                    t-on-click="() => this.setMoveType('in_invoice')">
                                <i class="fa fa-truck me-1"/> Vendor Due Report
                            </button>
                        </div>

                        <!-- Status Filter Buttons (All Outstanding, Upcoming Due, Overdue) -->
                        <div class="btn-group ms-1" role="group">
                            <button type="button"
                                    t-attf-class="btn btn-sm {{ state.due_filter === 'all' ? 'btn-dark' : 'btn-outline-dark' }}"
                                    t-on-click="() => this.setDueFilter('all')">
                                All Outstanding
                            </button>
                            <button type="button"
                                    t-attf-class="btn btn-sm {{ state.due_filter === 'upcoming' ? 'btn-success' : 'btn-outline-success' }}"
                                    t-on-click="() => this.setDueFilter('upcoming')">
                                <i class="fa fa-clock-o me-1"/> Upcoming Due
                            </button>
                            <button type="button"
                                    t-attf-class="btn btn-sm {{ state.due_filter === 'overdue' ? 'btn-danger' : 'btn-outline-danger' }}"
                                    t-on-click="() => this.setDueFilter('overdue')">
                                <i class="fa fa-exclamation-triangle me-1"/> Overdue
                            </button>
                        </div>
                    </div>

                    <!-- Right: Actions (Theme Toggle, Currency, Print PDF, Fold/Unfold, Refresh) -->
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-outline-secondary o_theme_btn" t-on-click="() => this.toggleTheme()" title="Toggle Dark / Light Theme">
                            <i t-attf-class="fa {{ state.theme === 'dark' ? 'fa-sun-o text-warning' : 'fa-moon-o' }} me-1"/>
                            <span t-esc="state.theme === 'dark' ? 'Light' : 'Dark'"/>
                        </button>

                        <!-- Currency Conversion Filter -->
                        <div class="position-relative">
                            <button type="button"
                                    t-attf-class="btn btn-sm {{ state.conversionApplied ? 'btn-primary' : 'btn-outline-secondary' }}"
                                    t-on-click="() => this.toggleCurrencyDropdown()"
                                    title="Convert amounts to a foreign currency">
                                <i class="fa fa-money me-1"/>
                                <span t-esc="currencyFilterLabel"/>
                                <i class="fa fa-caret-down ms-1"/>
                            </button>

                            <t t-if="state.isCurrencyDropdownOpen">
                                <div class="o_currency_panel position-absolute end-0 bg-white border rounded shadow-lg mt-1 z-3">
                                    <div class="o_currency_section_label px-2 pt-2">SELECT CURRENCY</div>
                                    <div class="o_currency_hint px-2 small text-muted">
                                        Default: each partner is shown in its own transaction currency.
                                    </div>

                                    <div class="o_currency_list mx-2 mt-1">
                                        <t t-if="(state.currencies || []).length === 0">
                                            <div class="text-muted p-2 text-center small">No currencies found</div>
                                        </t>
                                        <t t-foreach="state.currencies" t-as="curr" t-key="curr.id">
                                            <div class="list-group-item list-group-item-action d-flex align-items-center justify-content-between cursor-pointer"
                                                 t-on-click="() => this.onCurrencySelect(curr)">
                                                <span>
                                                    <span class="o_currency_sym me-1" t-esc="curr.symbol"/>
                                                    <span t-esc="curr.name"/>
                                                </span>
                                                <t t-if="state.selectedCurrencyId === curr.id">
                                                    <i class="fa fa-check text-primary"/>
                                                </t>
                                            </div>
                                        </t>
                                    </div>

                                    <hr class="my-2"/>

                                    <div class="px-2">
                                        <div class="o_currency_mode_toggle d-flex">
                                            <button type="button"
                                                    t-attf-class="o_currency_mode_item {{ state.useTransactionRates ? 'active' : '' }}"
                                                    t-on-click="() => this.toggleTransactionRates()">
                                                Transaction Rates
                                            </button>
                                            <button type="button"
                                                    t-attf-class="o_currency_mode_item {{ !state.useTransactionRates ? 'active' : '' }}"
                                                    t-on-click="() => this.selectCustomRateMode()">
                                                Custom Rate
                                            </button>
                                        </div>
                                    </div>

                                    <t t-if="!state.useTransactionRates">
                                        <div class="o_currency_rates px-2 mt-2">
                                            <t t-if="!state.selectedCurrencyId">
                                                <div class="small text-muted">Select a currency first.</div>
                                            </t>
                                            <t t-elif="customRateCurrencies.length === 0">
                                                <div class="small text-muted">
                                                    All documents are already in <t t-esc="state.selectedCurrencyName"/> - no rate needed.
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <t t-foreach="customRateRows" t-as="row" t-key="row.id">
                                                    <div class="mb-2">
                                                        <div class="o_currency_rate_row d-flex align-items-center gap-1">
                                                            <span class="small">1</span>
                                                            <span class="small fw-bold" t-esc="row.left"/>
                                                            <span class="small">=</span>
                                                            <input type="number" step="0.000001" min="0"
                                                                   class="o_currency_rate_input form-control form-control-sm"
                                                                   t-att-placeholder="row.placeholder"
                                                                   t-att-value="row.value"
                                                                   t-on-input="(ev) => this.onRateInput(row.id, ev)"/>
                                                            <span class="small fw-bold" t-esc="row.right"/>
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-secondary px-1 py-0 o_currency_swap_btn"
                                                                    title="Swap direction"
                                                                    t-on-click="() => this.swapRateDirection(row.id)">
                                                                <i class="fa fa-exchange"/>
                                                            </button>
                                                        </div>
                                                        <t t-if="row.hint">
                                                            <div class="o_currency_rate_hint small text-muted" t-esc="row.hint"/>
                                                        </t>
                                                        <t t-if="row.currentText">
                                                            <div class="o_currency_rate_hint small">
                                                                Current rate:
                                                                <a href="#" class="text-primary" title="Use the current rate"
                                                                   t-on-click.prevent="() => this.useCurrentRate(row.id)"
                                                                   t-esc="row.currentText"/>
                                                            </div>
                                                        </t>
                                                    </div>
                                                </t>
                                            </t>
                                        </div>
                                    </t>

                                    <hr class="my-2"/>

                                    <div class="o_currency_actions px-2 pb-2 d-flex gap-2">
                                        <button type="button" class="o_currency_apply_btn btn btn-sm btn-primary flex-fill"
                                                t-on-click="() => this.applyCurrencyConversion()">
                                            Apply
                                        </button>
                                        <button type="button" class="o_currency_reset_btn btn btn-sm btn-outline-secondary flex-fill"
                                                t-on-click="() => this.resetCurrencyConversion()">
                                            Reset
                                        </button>
                                    </div>

                                    <t t-if="state.conversionApplied">
                                        <div class="o_currency_applied_note px-2 pb-2 small">
                                            <i class="fa fa-info-circle me-1"/>
                                            Amounts shown in <t t-esc="state.selectedCurrencyName"/>
                                            (<t t-esc="state.useTransactionRates ? 'transaction rates' : 'custom rate'"/>)
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </div>

                        <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.expandAll()" title="Expand all partner groups">
                            <i class="fa fa-expand me-1"/> Expand All
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.collapseAll()" title="Collapse all partner groups">
                            <i class="fa fa-compress me-1"/> Collapse All
                        </button>
                        <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.loadReportData()" title="Reload data">
                            <i class="fa fa-refresh me-1"/> Refresh
                        </button>
                        <button class="btn btn-sm btn-success shadow-sm" t-on-click="() => this.onExportXLSX()" title="Export Excel Document">
                            <i class="fa fa-file-excel-o me-1"/> Export Excel
                        </button>
                        <button class="btn btn-sm btn-danger shadow-sm" t-on-click="() => this.onPrintPDF()" title="Print PDF Document">
                            <i class="fa fa-file-pdf-o me-1"/> Print PDF
                        </button>
                    </div>
                </div>

                <!-- Filters Row -->
                <div class="row g-2 mt-2 align-items-center">

                    <!-- Date Presets & Date Pickers -->
                    <div class="col-12 col-lg-5 col-xl-5 d-flex flex-wrap align-items-center gap-2">
                        <div class="input-group input-group-sm" style="width: auto;">
                            <span class="input-group-text bg-light"><i class="fa fa-calendar me-1"/> From</span>
                            <input type="date" class="form-control" t-model="state.date_from" t-on-change="() => this.onFilterChange()"/>
                            <span class="input-group-text bg-light">To</span>
                            <input type="date" class="form-control" t-model="state.date_to" t-on-change="() => this.onFilterChange()"/>
                        </div>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.setPreset('this_month')">Month</button>
                            <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.setPreset('this_quarter')">Quarter</button>
                            <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.setPreset('this_year')">YTD</button>
                            <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.setPreset('all')">All</button>
                        </div>
                    </div>

                    <!-- Analytic Account Filter -->
                    <div class="col-12 col-md-6 col-lg-4 col-xl-4 position-relative">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light">
                                <i class="fa fa-pie-chart me-1"/> Analytic
                            </span>
                            <div class="form-control d-flex flex-wrap align-items-center gap-1 p-1 bg-white cursor-pointer"
                                 t-on-click="() => this.toggleAnalyticDropdown()" style="min-height: 31px; max-height: 60px; overflow-y: auto;">
                                <t t-if="state.analytic_account_ids.length === 0">
                                    <span class="text-muted small">All Analytics</span>
                                </t>
                                <t t-foreach="getSelectedAnalyticObjects()" t-as="a" t-key="a.id">
                                    <span class="badge bg-secondary d-inline-flex align-items-center gap-1 text-truncate" style="max-width: 140px;">
                                        <t t-esc="a.display_name"/>
                                        <i class="fa fa-times cursor-pointer" t-on-click.stop="() => this.removeAnalytic(a.id)"/>
                                    </span>
                                </t>
                            </div>
                            <t t-if="state.analytic_account_ids.length > 0">
                                <button class="btn btn-outline-secondary" type="button" t-on-click="() => this.clearAnalytics()" title="Clear selection">
                                    <i class="fa fa-times"/>
                                </button>
                            </t>
                            <button class="btn btn-outline-secondary" type="button" t-on-click="() => this.toggleAnalyticDropdown()">
                                <i class="fa fa-caret-down"/>
                            </button>
                        </div>

                        <!-- Dropdown menu -->
                        <t t-if="state.isAnalyticDropdownOpen">
                            <div class="position-absolute start-0 end-0 bg-white border rounded shadow-lg p-2 mt-1 z-3" style="max-height: 250px; overflow-y: auto;">
                                <input type="text" class="form-control form-control-sm mb-2" placeholder="Search analytic..." t-model="state.analyticSearch"/>
                                <div class="list-group list-group-flush small">
                                    <t t-if="availableAnalytics.length === 0">
                                        <div class="text-muted p-2 text-center">No analytic accounts found</div>
                                    </t>
                                    <t t-foreach="availableAnalytics" t-as="a" t-key="a.id">
                                        <label class="list-group-item list-group-item-action d-flex align-items-center gap-2 p-1 cursor-pointer">
                                            <input type="checkbox"
                                                   t-att-checked="isAnalyticSelected(a.id)"
                                                   t-on-change="() => this.toggleAnalytic(a.id)"/>
                                            <span t-esc="a.display_name"/>
                                        </label>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Live search & Only Due Checkbox & Grand Total PDF Checkbox -->
                    <div class="col-12 col-md-6 col-lg-3 col-xl-3 d-flex align-items-center gap-2">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light"><i class="fa fa-search"/></span>
                            <input type="text" class="form-control" placeholder="Search partner, inv, ref, note..." t-att-value="state.searchQuery"
                                   t-on-input="(ev) => this.onSearchInput(ev)"/>
                            <t t-if="state.searchQuery">
                                <button class="btn btn-outline-secondary" type="button" t-on-click="() => this.onSearchClear()">
                                    <i class="fa fa-times"/>
                                </button>
                            </t>
                        </div>
                        <div class="form-check form-switch mb-0 text-nowrap" title="Show only documents with outstanding balance">
                            <input class="form-check-input" type="checkbox" id="onlyDueSwitch"
                                   t-model="state.only_due" t-on-change="() => this.onFilterChange()"/>
                            <label class="form-check-label small" for="onlyDueSwitch">Due Only</label>
                        </div>
                        <div class="form-check form-switch mb-0 text-nowrap" title="Include Grand Total Summary in PDF export">
                            <input class="form-check-input" type="checkbox" id="grandTotalSwitch"
                                   t-model="state.show_grand_total"/>
                            <label class="form-check-label small" for="grandTotalSwitch">Grand Total in PDF</label>
                        </div>
                        <div class="form-check form-switch mb-0 text-nowrap" title="Show partner email, phone and address in PDF and on screen">
                            <input class="form-check-input" type="checkbox" id="showAddressSwitch"
                                   t-model="state.show_address"/>
                            <label class="form-check-label small" for="showAddressSwitch">Address</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Loading overlay -->
            <t t-if="state.loading">
                <div class="text-center p-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="text-muted mt-2">Loading due report data...</div>
                </div>
            </t>

            <!-- Main Content Area -->
            <t t-else="">
                <div class="o_due_report_content p-3 p-md-4">

                    <!-- 6 KPI Summary Cards Matching Image 2 -->
                    <div class="row g-2 mb-3">
                        <!-- 1. Documents -->
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="card h-100 shadow-sm border-0 border-start border-4 border-info o_kpi_card">
                                <div class="card-body p-2 px-3">
                                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 10.5px;">DOCUMENTS</div>
                                    <div class="fw-bold text-dark mt-1" style="font-size: 15px;" t-esc="filteredTotals.invoice_count || 0"/>
                                    <div class="text-muted" style="font-size: 11px;"><t t-esc="filteredTotals.partner_count || 0"/> Partners</div>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Total Invoiced -->
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="card h-100 shadow-sm border-0 border-start border-4 border-secondary o_kpi_card">
                                <div class="card-body p-2 px-3">
                                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 10.5px;">TOTAL INVOICED</div>
                                    <div class="fw-bold text-dark mt-1" style="font-size: 14px;" t-esc="formatAmount(filteredTotals.bill_amount)"/>
                                    <div class="text-muted" style="font-size: 11px;">Bill Amount</div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. Total Paid -->
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="card h-100 shadow-sm border-0 border-start border-4 border-success o_kpi_card">
                                <div class="card-body p-2 px-3">
                                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 10.5px;">TOTAL PAID</div>
                                    <div class="fw-bold text-success mt-1" style="font-size: 14px;" t-esc="formatAmount(filteredTotals.paid)"/>
                                    <div class="text-muted" style="font-size: 11px;">Received / Settled</div>
                                </div>
                            </div>
                        </div>

                        <!-- 4. Upcoming Due -->
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="card h-100 shadow-sm border-0 border-start border-4 border-primary bg-info-subtle o_kpi_card">
                                <div class="card-body p-2 px-3">
                                    <div class="text-primary text-uppercase fw-semibold" style="font-size: 10.5px;">UPCOMING DUE</div>
                                    <div class="fw-bold text-primary mt-1" style="font-size: 14px;" t-esc="formatAmount(filteredTotals.upcoming_balance)"/>
                                    <div class="text-primary" style="font-size: 11px;"><t t-esc="filteredTotals.upcoming_count || 0"/> Invoices Not Overdue</div>
                                </div>
                            </div>
                        </div>

                        <!-- 5. Overdue Amount -->
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="card h-100 shadow-sm border-0 border-start border-4 border-danger bg-danger-subtle o_kpi_card">
                                <div class="card-body p-2 px-3">
                                    <div class="text-danger text-uppercase fw-semibold" style="font-size: 10.5px;">OVERDUE AMOUNT</div>
                                    <div class="fw-bold text-danger mt-1" style="font-size: 14px;" t-esc="formatAmount(filteredTotals.overdue_balance)"/>
                                    <div class="text-danger" style="font-size: 11px;"><t t-esc="filteredTotals.overdue_count || 0"/> Overdue Invoices</div>
                                </div>
                            </div>
                        </div>

                        <!-- 6. Total Balance Due -->
                        <div class="col-6 col-md-4 col-xl-2">
                            <div class="card h-100 shadow-sm border-0 border-start border-4 border-warning bg-warning-subtle o_kpi_card">
                                <div class="card-body p-2 px-3">
                                    <div class="text-warning-emphasis text-uppercase fw-semibold" style="font-size: 10.5px;">TOTAL BALANCE DUE</div>
                                    <div class="fw-bold text-danger mt-1" style="font-size: 14px;" t-esc="formatAmount(filteredTotals.balance)"/>
                                    <div class="text-warning-emphasis" style="font-size: 11px;">
                                        <t t-if="state.move_type === 'out_invoice'">Total Receivable</t>
                                        <t t-else="">Total Payable</t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Empty State -->
                    <t t-if="filteredGroups.length === 0">
                        <div class="card bg-white shadow-sm border-0 text-center p-5 my-4">
                            <div class="text-muted fs-1 mb-2"><i class="fa fa-folder-open-o"/></div>
                            <h5 class="text-secondary">No records found</h5>
                            <p class="text-muted small">No due records found for the selected criteria.</p>
                        </div>
                    </t>

                    <!-- Grouped Tables per Partner -->
                    <t t-foreach="pagedGroups" t-as="group" t-key="group.partner_id">
                        <div class="card shadow-sm mb-4 border-0 o_partner_group_card">

                            <!-- Partner Header Card -->
                            <div class="card-header bg-white d-flex justify-content-between align-items-center py-2 px-3 cursor-pointer border-bottom"
                                 t-on-click="() => this.toggleGroupCollapse(group.partner_id)">
                                <div class="d-flex align-items-center gap-2">
                                    <i t-attf-class="fa {{ isGroupCollapsed(group.partner_id) ? 'fa-chevron-right text-muted' : 'fa-chevron-down text-primary' }}"/>
                                    <span class="fw-bold fs-6 text-dark" t-esc="group.partner_name"/>
                                    <span class="badge bg-light text-dark border">
                                        <t t-esc="group.count"/> <t t-esc="group.count === 1 ? 'record' : 'records'"/>
                                    </span>
                                    <span class="badge bg-info-subtle text-primary border border-info-subtle o_currency_badge"
                                          t-att-title="group.mixed_docs ? 'Documents are in several currencies - shown in company currency' : 'Partner currency'">
                                        <i t-if="group.mixed_docs" class="fa fa-exchange me-1"/>
                                        <t t-esc="group.currency.name"/>
                                    </span>

                                </div>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="text-end small">
                                        <span class="text-muted me-1">Upcoming Due:</span>
                                        <span class="fw-bold text-primary me-3" t-esc="formatAmount(group.subtotal_upcoming, group.currency)"/>
                                        <span class="text-muted me-1">Overdue:</span>
                                        <span class="fw-bold text-danger me-3" t-esc="formatAmount(group.subtotal_overdue, group.currency)"/>
                                        <span class="text-muted me-1">Total Balance:</span>
                                        <span class="fw-bold text-danger fs-6" t-esc="formatAmount(group.subtotal_balance, group.currency)"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Partner Address Block (shown when Address toggle is on) -->
                            <t t-if="state.show_address and group.partner_address">
                                <div class="px-3 py-2 border-bottom d-flex flex-wrap gap-3 small text-muted" style="background-color: #f8fafc;">
                                    <t t-if="group.partner_address.email">
                                        <span>
                                            <i class="fa fa-envelope me-1 text-secondary"/>
                                            <t t-esc="group.partner_address.email"/>
                                        </span>
                                    </t>
                                    <t t-if="group.partner_address.phone">
                                        <span>
                                            <i class="fa fa-phone me-1 text-secondary"/>
                                            <t t-esc="group.partner_address.phone"/>
                                        </span>
                                    </t>
                                    <t t-if="group.partner_address.address_line1 or group.partner_address.address_line2">
                                        <span>
                                            <i class="fa fa-map-marker me-1 text-secondary"/>
                                            <t t-if="group.partner_address.address_line1">
                                                <t t-esc="group.partner_address.address_line1"/>
                                            </t>
                                            <t t-if="group.partner_address.address_line2">
                                                <span class="ms-1 text-muted">·</span>
                                                <t t-esc="group.partner_address.address_line2"/>
                                            </t>
                                        </span>
                                    </t>
                                </div>
                            </t>

                            <!-- Partner Table (Collapsible) -->
                            <t t-if="!isGroupCollapsed(group.partner_id)">
                                <t t-if="!group.lines_loaded">
                                    <div class="text-center text-muted small p-3">
                                        <span class="spinner-border spinner-border-sm me-2" role="status"/>
                                        Loading documents...
                                    </div>
                                </t>
                                <t t-else="">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-hover mb-0 o_due_table">
                                        <thead>
                                            <tr class="o_table_header">
                                                <th class="text-center" style="width: 45px;">SlNo</th>
                                                <th class="text-center" style="width: 95px;">Date</th>
                                                <th style="width: 150px;">VNo</th>
                                                <th class="text-center" style="width: 70px;">Due Day</th>
                                                <th class="text-center" style="width: 95px;">Due Date</th>
                                                <th class="text-center" style="width: 110px;">Status / Days</th>
                                                <th class="text-end" style="width: 125px;">Bill Amount</th>
                                                <th class="text-end" style="width: 120px;">Paid</th>
                                                <th class="text-end" style="width: 130px;">Balance Due</th>
                                                <th style="width: 160px;">
                                                    <t t-if="state.move_type === 'out_invoice'">PO/Reference #</t>
                                                    <t t-else="">Vendor Ref #</t>
                                                </th>
                                                <th style="width: 130px;">
                                                    <t t-if="state.move_type === 'out_invoice'">Salesman</t>
                                                    <t t-else="">Buyer</t>
                                                </th>
                                                <th style="width: 180px;">Narration</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="group.lines" t-as="line" t-key="line.move_id">
                                                <tr class="o_due_row">
                                                    <td class="text-center text-muted small" t-esc="line.sino"/>
                                                    <td class="text-center" t-esc="formatDisplayDate(line.date)"/>
                                                    <td>
                                                        <a href="#" class="fw-bold text-decoration-none o_vno_link"
                                                           t-on-click.prevent="() => this.openInvoice(line.move_id)"
                                                           title="Open Invoice">
                                                            <i class="fa fa-external-link me-1 small"/> <t t-esc="line.vno"/>
                                                        </a>
                                                        <t t-if="line.is_refund">
                                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1" style="font-size: 9.5px;">Refund</span>
                                                        </t>
                                                        <div t-if="line.paid_by_text" class="text-muted" style="font-size: 10px; line-height: 1.2;">
                                                            <t t-esc="line.paid_by_text"/>
                                                        </div>
                                                    </td>
                                                    <td class="text-center" t-esc="line.due_day"/>
                                                    <td class="text-center" t-esc="formatDisplayDate(line.due_date)"/>
                                                    <td class="text-center">
                                                        <t t-if="line.is_unapplied">
                                                            <span class="badge rounded-pill bg-info-subtle text-primary border px-2 py-1">
                                                                <i class="fa fa-money me-1"/> Unapplied
                                                            </span>
                                                        </t>
                                                        <t t-elif="line.is_overdue">
                                                            <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                                <i class="fa fa-clock-o me-1"/> <t t-esc="line.rem_over_days"/> Over
                                                            </span>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                                <i class="fa fa-check me-1"/> <t t-esc="line.rem_over_days"/> Rem.
                                                            </span>
                                                        </t>
                                                    </td>
                                                    <td class="text-end" t-esc="formatAmount(line.bill_amount, group.currency)"/>
                                                    <td class="text-end text-success" t-esc="formatAmount(line.paid, group.currency)"/>
                                                    <td class="text-end fw-bold text-danger" t-esc="formatAmount(line.balance, group.currency)"/>
                                                    <td class="small">
                                                        <t t-if="state.move_type === 'out_invoice'">
                                                            <t t-esc="line.lpo"/>
                                                        </t>
                                                        <t t-else="">
                                                            <t t-esc="line.inv_number"/>
                                                        </t>
                                                    </td>
                                                    <td class="small" t-esc="line.salesman"/>
                                                    <td class="small text-truncate" style="max-width: 200px;" t-att-title="line.narration">
                                                        <t t-esc="line.narration"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                        <tfoot>
                                            <tr class="o_table_subtotal_row fw-bold">
                                                <td colspan="6" class="text-end">Partner Total:</td>
                                                <td class="text-end" t-esc="formatAmount(group.subtotal_bill_amount, group.currency)"/>
                                                <td class="text-end text-success" t-esc="formatAmount(group.subtotal_paid, group.currency)"/>
                                                <td class="text-end text-danger" t-esc="formatAmount(group.subtotal_balance, group.currency)"/>
                                                <td colspan="3"/>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                                </t>
                            </t>
                        </div>
                    </t>

                    <!-- Pagination Bar -->
                    <t t-if="filteredGroups.length > 0">
                        <div class="card shadow-sm border-0 mb-4 p-2 px-3 bg-white">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <div class="d-flex align-items-center gap-2 small text-muted">
                                    <span>Showing <strong><t t-esc="paginationStart"/></strong> to <strong><t t-esc="paginationEnd"/></strong> of <strong><t t-esc="filteredGroups.length"/></strong> partners</span>
                                    <span class="text-secondary">|</span>
                                    <span>Per page:</span>
                                    <select class="form-select form-select-sm" style="width: auto;"
                                            t-on-change="(ev) => this.setPageSize(ev.target.value)">
                                        <option value="20" t-att-selected="state.pageSize === 20">20</option>
                                        <option value="50" t-att-selected="state.pageSize === 50">50</option>
                                        <option value="100" t-att-selected="state.pageSize === 100">100</option>
                                        <option value="all" t-att-selected="state.pageSize === 'all'">All</option>
                                    </select>
                                </div>
                                <t t-if="totalPages > 1 and state.pageSize !== 'all'">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-secondary"
                                                t-att-disabled="state.currentPage &lt;= 1"
                                                t-on-click="() => this.setPage(1)" title="First page">
                                            <i class="fa fa-angle-double-left"/>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary"
                                                t-att-disabled="state.currentPage &lt;= 1"
                                                t-on-click="() => this.setPage(state.currentPage - 1)" title="Previous page">
                                            <i class="fa fa-angle-left"/> Prev
                                        </button>
                                        <button type="button" class="btn btn-primary disabled" style="min-width: 80px;">
                                            <t t-esc="state.currentPage"/> / <t t-esc="totalPages"/>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary"
                                                t-att-disabled="state.currentPage &gt;= totalPages"
                                                t-on-click="() => this.setPage(state.currentPage + 1)" title="Next page">
                                            Next <i class="fa fa-angle-right"/>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary"
                                                t-att-disabled="state.currentPage &gt;= totalPages"
                                                t-on-click="() => this.setPage(totalPages)" title="Last page">
                                            <i class="fa fa-angle-double-right"/>
                                        </button>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>

                    <!-- Grand Total Card at bottom (Light Grey) Matching Image 2 -->
                    <t t-if="filteredGroups.length > 0">
                        <div class="card o_grand_total_card shadow-sm p-3 mb-4 border">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                                <div>
                                    <h6 class="mb-0 fw-bold o_gt_title">Grand Total Summary</h6>
                                    <div class="text-muted small">
                                        Across <t t-esc="filteredTotals.partner_count"/> partners and <t t-esc="filteredTotals.invoice_count"/> documents
                                    </div>
                                </div>
                                <div class="d-flex flex-wrap align-items-center gap-4 text-end">
                                    <div>
                                        <div class="text-muted small">Total Invoiced</div>
                                        <div class="fs-6 fw-bold o_gt_val" t-esc="formatAmount(filteredTotals.bill_amount)"/>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Total Paid</div>
                                        <div class="fs-6 fw-bold text-success" t-esc="formatAmount(filteredTotals.paid)"/>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Upcoming Due</div>
                                        <div class="fs-6 fw-bold text-primary" t-esc="formatAmount(filteredTotals.upcoming_balance)"/>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Overdue</div>
                                        <div class="fs-6 fw-bold text-danger" t-esc="formatAmount(filteredTotals.overdue_balance)"/>
                                    </div>
                                    <div class="ps-3 border-start border-secondary-subtle">
                                        <div class="text-danger small fw-semibold">Total Outstanding Balance</div>
                                        <div class="fs-5 fw-bold text-danger" t-esc="formatAmount(filteredTotals.balance)"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>

                </div>
            </t>
        </div>
    </t>

</templates>