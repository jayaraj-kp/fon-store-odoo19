<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= Customer Due Report ================= -->
    <template id="report_customer_due_document">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page" style="font-family: Arial, Helvetica, sans-serif; font-size: 11px; margin-top:0; padding-top:0;">

                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <t t-if="company.logo">
                                <img t-att-src="image_data_uri(company.logo)" style="max-height:55px; max-width:170px; object-fit:contain;"/>
                            </t>
                            <div style="font-weight:bold; font-size:14px;" t-esc="company.name"/>
                        </div>
                        <div style="text-align:right;">
                            <t t-if="date_from">
                                <span t-esc="date_from" t-options="{'widget': 'date'}"/> To
                            </t>
                            <t t-else="">
                                <span>As of</span>
                            </t>
                            <span t-esc="date_to" t-options="{'widget': 'date'}"/>
                        </div>
                    </div>

                    <div style="text-align:center; margin-top:6px;">
                        <div style="font-weight:bold; font-size:14px;">Customers Due Report</div>
                        <div>
                            <t t-if="date_from">
                                <span t-esc="date_from" t-options="{'widget': 'date'}"/> To
                            </t>
                            <t t-else="">
                                <span>As of</span>
                            </t>
                            <span t-esc="date_to" t-options="{'widget': 'date'}"/>
                        </div>
                        <t t-if="analytic_names">
                            <div style="font-size:11px; color:#555; margin-top:2px;">
                                Analytic: <span style="font-weight:bold;" t-esc="analytic_names"/>
                            </div>
                        </t>
                    </div>

                    <t t-foreach="groups" t-as="group">
                        <div style="margin-top:16px; margin-bottom:3px;">
                            <div style="font-weight:bold; font-size:12px;">
                                <span t-esc="group['partner_name']"/>
                                <span style="font-weight:normal; font-size:10px; color:#555;"> (<t t-esc="group['currency']['name']"/>)</span>
                            </div>
                            <t t-if="show_address and group.get('partner_address')">
                                <div style="font-size:10px; color:#444; margin-top:2px; line-height:1.6;">
                                    <t t-if="group['partner_address']['email']">
                                        <span>&#9993; <t t-esc="group['partner_address']['email']"/></span>
                                    </t>
                                    <t t-if="group['partner_address']['phone']">
                                        <span style="margin:0 5px;">|</span>
                                        <span>&#9742; <t t-esc="group['partner_address']['phone']"/></span>
                                    </t>
                                    <t t-if="group['partner_address']['address_line1']">
                                        <span style="margin:0 5px;">|</span>
                                        <span t-esc="group['partner_address']['address_line1']"/>
                                    </t>
                                    <t t-if="group['partner_address']['address_line2']">
                                        <span>, <t t-esc="group['partner_address']['address_line2']"/></span>
                                    </t>
                                </div>
                            </t>
                        </div>

                        <table class="table" style="border-collapse:collapse; width:100%;">
                            <thead>
                                <tr style="background-color:#9db4c4; font-weight:bold;">
                                    <th style="border:1px solid #999; padding:4px;">SlNo</th>
                                    <th style="border:1px solid #999; padding:4px;">Date</th>
                                    <th style="border:1px solid #999; padding:4px;">VNo</th>
                                    <th style="border:1px solid #999; padding:4px;">Due Day</th>
                                    <th style="border:1px solid #999; padding:4px;">Due Date</th>
                                    <th style="border:1px solid #999; padding:4px;">Status / Days</th>
                                    <th style="border:1px solid #999; padding:4px; text-align:right;">Bill Amount</th>
                                    <th style="border:1px solid #999; padding:4px; text-align:right;">Paid</th>
                                    <th style="border:1px solid #999; padding:4px; text-align:right;">Balance Due</th>
                                    <th style="border:1px solid #999; padding:4px;">PO/Reference #</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="group['lines']" t-as="line">
                                    <td style="border:1px solid #ccc; padding:3px; text-align:center;" t-esc="line['sino']"/>
                                    <td style="border:1px solid #ccc; padding:3px; text-align:center;" t-esc="line['date']" t-options="{'widget': 'date'}"/>
                                    <td style="border:1px solid #ccc; padding:3px;">
                                        <span t-esc="line['vno']"/>
                                        <t t-if="line.get('is_refund')">
                                            <span style="font-size: 8px; color: #b45309; border: 1px solid #f59e0b; border-radius: 3px; padding: 0 2px; margin-left: 2px;">Refund</span>
                                        </t>
                                        <div t-if="line.get('paid_by_text')" style="font-size: 8px; color: #64748b;">
                                            <t t-esc="line['paid_by_text']"/>
                                        </div>
                                    </td>
                                    <td style="border:1px solid #ccc; padding:3px; text-align:center;" t-esc="line['due_day']"/>
                                    <td style="border:1px solid #ccc; padding:3px; text-align:center;" t-esc="line['due_date']" t-options="{'widget': 'date'}"/>
                                    <td style="border:1px solid #ccc; padding:3px; text-align:center;">
                                        <t t-if="line.get('is_unapplied')">
                                            <span style="font-weight:bold;">Unapplied</span>
                                        </t>
                                        <t t-elif="line['is_overdue']">
                                            <span style="font-weight:bold;"><t t-esc="line['rem_over_days']"/> Over</span>
                                        </t>
                                        <t t-else="">
                                            <span style="font-weight:bold;"><t t-esc="line['rem_over_days']"/> Rem.</span>
                                        </t>
                                    </td>
                                    <td style="border:1px solid #ccc; padding:3px; text-align:right;" t-esc="line['bill_amount']" t-options="{'widget': 'monetary', 'display_currency': group['currency_rec']}"/>
                                    <td style="border:1px solid #ccc; padding:3px; text-align:right;" t-esc="line['paid']" t-options="{'widget': 'monetary', 'display_currency': group['currency_rec']}"/>
                                    <td style="border:1px solid #ccc; padding:3px; text-align:right; font-weight:bold;" t-esc="line['balance']" t-options="{'widget': 'monetary', 'display_currency': group['currency_rec']}"/>
                                    <td style="border:1px solid #ccc; padding:3px;" t-esc="line['lpo']"/>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr style="font-weight:bold; background-color:#e2e2e2;">
                                    <td colspan="6" style="border:1px solid #999; padding:4px; text-align:right;">Partner Total:</td>
                                    <td style="border:1px solid #999; padding:4px; text-align:right;" t-esc="group['subtotal_bill_amount']" t-options="{'widget': 'monetary', 'display_currency': group['currency_rec']}"/>
                                    <td style="border:1px solid #999; padding:4px; text-align:right;" t-esc="group['subtotal_paid']" t-options="{'widget': 'monetary', 'display_currency': group['currency_rec']}"/>
                                    <td style="border:1px solid #999; padding:4px; text-align:right;" t-esc="group['subtotal_balance']" t-options="{'widget': 'monetary', 'display_currency': group['currency_rec']}"/>
                                    <td style="border:1px solid #999; padding:4px;"/>
                                </tr>
                            </tfoot>
                        </table>
                    </t>

                    <t t-if="show_grand_total and grand_totals">
                        <div style="margin-top:18px; font-size:11px; line-height:1.7; page-break-inside:avoid;">
                            <div style="font-weight:bold; font-size:12px;">Grand Total Summary</div>
                            <div style="font-size:10px; color:#666;">
                                Across <t t-esc="grand_totals['partner_count']"/> partners and <t t-esc="grand_totals['invoice_count']"/> documents
                            </div>
                            <div style="font-weight:bold;">Total Invoiced: <span t-esc="grand_totals['bill_amount']" t-options="{'widget': 'monetary', 'display_currency': display_currency}"/></div>
                            <div style="font-weight:bold;">Total Paid: <span t-esc="grand_totals['paid']" t-options="{'widget': 'monetary', 'display_currency': display_currency}"/></div>
                            <div style="font-weight:bold;">Upcoming Due: <span t-esc="grand_totals['upcoming_balance']" t-options="{'widget': 'monetary', 'display_currency': display_currency}"/></div>
                            <div style="font-weight:bold;">Overdue: <span t-esc="grand_totals['overdue_balance']" t-options="{'widget': 'monetary', 'display_currency': display_currency}"/></div>
                            <div style="font-weight:bold;">Grand Total: <span t-esc="grand_totals['balance']" t-options="{'widget': 'monetary', 'display_currency': display_currency}"/></div>

                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>

