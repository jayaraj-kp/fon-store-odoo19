<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Slim paper format: the default Odoo format reserves a large top
         margin for a repeating header/footer. Since these reports draw
         their own header, use a small margin so content starts near the
         top of the page (fixes the "big gap at the top" issue). -->
    <record id="paperformat_due_report" model="report.paperformat">
        <field name="name">Due Report</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_customer_due" model="ir.actions.report">
        <field name="name">Customer Due Report</field>
        <field name="model">due.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_due_reports.report_customer_due_document</field>
        <field name="report_file">custom_due_reports.report_customer_due_document</field>
        <field name="print_report_name">'Customer Due Report'</field>
        <field name="paperformat_id" ref="paperformat_due_report"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="action_report_vendor_due" model="ir.actions.report">
        <field name="name">Vendor Due Report</field>
        <field name="model">due.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_due_reports.report_vendor_due_document</field>
        <field name="report_file">custom_due_reports.report_vendor_due_document</field>
        <field name="print_report_name">'Vendor Due Report'</field>
        <field name="paperformat_id" ref="paperformat_due_report"/>
        <field name="binding_model_id" eval="False"/>
    </record>

</odoo>
