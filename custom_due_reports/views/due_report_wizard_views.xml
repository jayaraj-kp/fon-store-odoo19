<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_due_report_wizard_form" model="ir.ui.view">
        <field name="name">due.report.wizard.form</field>
        <field name="model">due.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Due Report">
                <field name="move_type" invisible="1"/>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="only_due"/>
                        <field name="due_filter"/>
                    </group>
                </group>
                <group>
                    <field name="partner_ids" widget="many2many_tags"
                           placeholder="All (or select specific partners)"/>
                    <field name="analytic_account_ids" widget="many2many_tags"
                           placeholder="All (or select specific analytic accounts)"
                           options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_view_report" type="object"
                            string="View Report" class="btn-primary"/>
                    <button name="action_print_report" type="object"
                            string="Print PDF" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_customer_due_report_wizard" model="ir.actions.act_window">
        <field name="name">Customer Due Report</field>
        <field name="res_model">due.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>

    <record id="action_vendor_due_report_wizard" model="ir.actions.act_window">
        <field name="name">Vendor Due Report</field>
        <field name="res_model">due.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
    </record>

</odoo>
