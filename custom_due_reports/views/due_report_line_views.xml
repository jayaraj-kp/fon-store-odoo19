<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= Customer Due Report - on screen ================= -->
    <record id="view_due_report_line_customer_list" model="ir.ui.view">
        <field name="name">due.report.line.customer.list</field>
        <field name="model">due.report.line</field>
        <field name="arch" type="xml">
            <list string="Customer Due Report" create="false" edit="false" delete="false" import="false">
                <field name="sino" string="SlNo"/>
                <field name="vno" string="VNo"/>
                <field name="date"/>
                <field name="partner_id" string="Party Name"/>
                <field name="due_day"/>
                <field name="due_date"/>
                <field name="rem_over_days" string="Rem./Over"/>
                <field name="rem_over_label" string=""/>
                <field name="narration"/>
                <field name="bill_amount" sum="Total"/>
                <field name="paid" sum="Total"/>
                <field name="balance" sum="Total"/>
                <field name="total_amount" sum="Total"/>
                <field name="salesman_id"/>
                <field name="lpo" string="L.P.O"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_customer_due_report_lines" model="ir.actions.act_window">
        <field name="name">Customer Due Report</field>
        <field name="res_model">due.report.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_due_report_line_customer_list"/>
        <field name="target">current</field>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
    </record>

    <record id="action_customer_due_report_client" model="ir.actions.client">
        <field name="name">Customer Due Report</field>
        <field name="tag">custom_due_reports.DueReportView</field>
        <field name="target">current</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>

    <!-- ================= Vendor Due Report - on screen ================= -->
    <record id="view_due_report_line_vendor_list" model="ir.ui.view">
        <field name="name">due.report.line.vendor.list</field>
        <field name="model">due.report.line</field>
        <field name="arch" type="xml">
            <list string="Vendor Due Report" create="false" edit="false" delete="false" import="false">
                <field name="sino" string="SlNo"/>
                <field name="vno" string="VNo"/>
                <field name="date"/>
                <field name="due_day"/>
                <field name="due_date"/>
                <field name="rem_over_days" string="Rem./Over"/>
                <field name="rem_over_label" string=""/>
                <field name="bill_amount" sum="Total"/>
                <field name="paid" sum="Total"/>
                <field name="balance" sum="Total"/>
                <field name="total_amount" sum="Total"/>
                <field name="inv_number" string="Inv.Number"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_vendor_due_report_lines" model="ir.actions.act_window">
        <field name="name">Vendor Due Report</field>
        <field name="res_model">due.report.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_due_report_line_vendor_list"/>
        <field name="target">current</field>
        <field name="domain">[('move_type', '=', 'in_invoice')]</field>
    </record>

    <record id="action_vendor_due_report_client" model="ir.actions.client">
        <field name="name">Vendor Due Report</field>
        <field name="tag">custom_due_reports.DueReportView</field>
        <field name="target">current</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
    </record>

</odoo>
