<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_scheduled_price" model="ir.ui.view">
        <field name="name">product.template.form.scheduled.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Scheduled Prices" name="scheduled_prices">
                    <field name="temp_price_ids">
                        <list editable="bottom">
                            <field name="price"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" column_invisible="True"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
