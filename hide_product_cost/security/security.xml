<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shows as a "Product Cost" selection (Visible / Hidden) on the user form -->
    <record id="res_groups_privilege_product_cost" model="res.groups.privilege">
        <field name="name">Product Cost</field>
        <field name="placeholder">Visible</field>
        <field name="category_id" ref="base.module_category_master_data"/>
    </record>

    <record id="group_hide_product_cost" model="res.groups">
        <field name="name">Hidden</field>
        <field name="privilege_id" ref="res_groups_privilege_product_cost"/>
    </record>
</odoo>
