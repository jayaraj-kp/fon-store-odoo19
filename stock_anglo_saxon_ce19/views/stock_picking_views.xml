<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_picking_anglo_saxon_buttons" model="ir.ui.view">
            <field name="name">stock.picking.anglo.saxon.buttons</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">

                    <!-- Smart button: Receipt journal entries -->
                    <button
                        type="object"
                        name="action_view_receipt_journal_entries"
                        class="oe_stat_button"
                        icon="fa-book"
                        invisible="receipt_journal_entry_count == 0"
                        groups="account.group_account_readonly">
                        <field
                            name="receipt_journal_entry_count"
                            widget="statinfo"
                            string="Receipt Entries"/>
                    </button>

                    <!-- Smart button: Delivery journal entries -->
                    <button
                        type="object"
                        name="action_view_delivery_journal_entries"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="delivery_journal_entry_count == 0"
                        groups="account.group_account_readonly">
                        <field
                            name="delivery_journal_entry_count"
                            widget="statinfo"
                            string="Delivery Entries"/>
                    </button>

                </xpath>
            </field>
        </record>
    </data>
</odoo>
