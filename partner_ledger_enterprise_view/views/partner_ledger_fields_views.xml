<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Narration field on Sale Order form — bottom area next to notes -->
    <record id="view_sale_order_narration" model="ir.ui.view">
        <field name="name">sale.order.narration</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='note']" position="after">
                <field name="narration" placeholder="Narration..."/>
            </xpath>
        </field>
    </record>

    <!-- Narration field on Purchase Order form — bottom area next to notes -->
    <record id="view_purchase_order_narration" model="ir.ui.view">
        <field name="name">purchase.order.narration</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='note']" position="after">
                <field name="narration" placeholder="Narration..."/>
            </xpath>
        </field>
    </record>

    <!-- Narration field on Payment creation wizard (the "Pay" dialog) -->
    <record id="view_payment_register_narration" model="ir.ui.view">
        <field name="name">account.payment.register.narration</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='communication']" position="after">
                <field name="narration" placeholder="Narration..."/>
            </xpath>
        </field>
    </record>

    <!-- Narration field on Payment form -->
    <record id="view_payment_narration" model="ir.ui.view">
        <field name="name">account.payment.narration</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='memo']" position="after">
                <field name="narration" placeholder="Narration..."/>
            </xpath>
        </field>
    </record>

    <!-- Narration field on Journal Entry form — visible only for journal entries -->
    <record id="view_journal_entry_narration" model="ir.ui.view">
        <field name="name">account.move.journal.entry.narration</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority" eval="25"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab_entry']//field[@name='narration']" position="attributes">
                <attribute name="placeholder">Narration...</attribute>
                <attribute name="height">80</attribute>
            </xpath>
        </field>
    </record>

</odoo>
