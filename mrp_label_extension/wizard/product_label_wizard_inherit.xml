<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Inherit the standard "Print Product Labels" wizard form view
        (product_label_print.product_label_wizard_view_form) and insert
        a new "Show MRP Price" field directly below "Show Sales Price".
    -->
    <record id="product_label_wizard_view_form_inherit_mrp" model="ir.ui.view">
        <field name="name">product.label.wizard.form.inherit.mrp</field>
        <field name="model">product.label.wizard</field>
        <field name="inherit_id" ref="product_label_print.product_label_wizard_view_form"/>
        <field name="arch" type="xml">

            <!-- Insert show_mrp_price after show_mrp field (the standard Show Sales Price field) -->
            <xpath expr="//field[@name='show_mrp']" position="after">
                <field name="show_mrp_price"
                       string="Show MRP Price"
                       help="When enabled, prints the MRP Price (mrp_price) on the label."/>
            </xpath>

        </field>
    </record>

</odoo>