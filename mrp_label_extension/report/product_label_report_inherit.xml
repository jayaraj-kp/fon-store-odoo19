<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        ══════════════════════════════════════════════════════════════════════
        The standard product_label_print module has these QWeb templates:

          product_label_print.report_product_label_dymo
          product_label_print.report_product_label_small_2x7
          product_label_print.report_product_label

        Each has a price cell that renders product.lst_price when show_mrp=True
        (confusingly named — in Odoo's standard module "show_mrp" means show
        the sales/list price labelled as "MRP").

        We inherit each template and, when our new show_mrp_price flag is set,
        we ALSO show a second price line using product.mrp_price.

        Strategy: after the existing price cell, insert a conditional block
        that adds "MRP: Rs. X" when docs['show_mrp'] (our flag) is True.
        ══════════════════════════════════════════════════════════════════════
    -->

    <!-- ── Medium label (40×25mm — Barcode) ─────────────────────────────── -->
    <template id="report_product_label_mrp_price"
              inherit_id="product_label_print.report_product_label">
        <xpath expr="//div[@class='o_barcode_price']" position="after">
            <t t-if="data and data.get('show_mrp')">
                <div style="font-size:8pt;font-weight:bold;text-align:center;
                            line-height:1.3;margin-top:1px;">
                    MRP Rs.<t t-out="'%.2f' % (product.mrp_price or 0.0)"/>
                </div>
            </t>
        </xpath>
    </template>

    <!-- ── Small label (25×15mm) ─────────────────────────────────────────── -->
    <template id="report_product_label_small_mrp_price"
              inherit_id="product_label_print.report_product_label_small_2x7">
        <xpath expr="//div[@class='o_barcode_price']" position="after">
            <t t-if="data and data.get('show_mrp')">
                <div style="font-size:6pt;font-weight:bold;text-align:center;
                            line-height:1.3;margin-top:1px;">
                    MRP Rs.<t t-out="'%.2f' % (product.mrp_price or 0.0)"/>
                </div>
            </t>
        </xpath>
    </template>

    <!-- ── Dymo / Key-chain label (65×54mm — GP-1125T Roll) ─────────────── -->
    <template id="report_product_label_dymo_mrp_price"
              inherit_id="product_label_print.report_product_label_dymo">
        <xpath expr="//div[@class='o_barcode_price']" position="after">
            <t t-if="data and data.get('show_mrp')">
                <div style="font-size:9pt;font-weight:bold;text-align:center;
                            line-height:1.3;margin-top:2px;">
                    MRP Rs.<t t-out="'%.2f' % (product.mrp_price or 0.0)"/>
                </div>
            </t>
        </xpath>
    </template>

</odoo>