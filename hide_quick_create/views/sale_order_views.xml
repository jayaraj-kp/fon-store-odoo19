<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Hide "Create" and "Create and edit..." quick-create options
        from the product_id field in Sale Order lines.
    -->
    <record id="sale_order_line_form_view_hide_quick_create" model="ir.ui.view">
        <field name="name">sale.order.line.form.hide.quick.create</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- product_id field in sale order lines -->
            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="attributes">
                <attribute name="no_quick_create">1</attribute>
                <attribute name="no_create_edit">1</attribute>
                <attribute name="no_create">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
