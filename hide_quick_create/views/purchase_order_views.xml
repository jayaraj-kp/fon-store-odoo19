<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Hide "Create" and "Create and edit..." quick-create options
        from the product_id field in Purchase Order lines.
    -->
    <record id="purchase_order_line_form_view_hide_quick_create" model="ir.ui.view">
        <field name="name">purchase.order.line.form.hide.quick.create</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- product_id field in the order lines tree (inline editable) -->
            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="attributes">
                <attribute name="no_quick_create">1</attribute>
                <attribute name="no_create_edit">1</attribute>
                <attribute name="no_create">1</attribute>
            </xpath>
        </field>
    </record>


</odoo>
