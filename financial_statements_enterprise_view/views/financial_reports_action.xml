<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Balance Sheet client action -->
    <record id="action_balance_sheet_enterprise" model="ir.actions.client">
        <field name="name">Balance Sheet</field>
        <field name="tag">fs_enterprise.FinancialStatementsView</field>
        <field name="target">current</field>
        <field name="params">{'default_report_type': 'bs'}</field>
    </record>

    <!-- Profit and Loss client action -->
    <record id="action_profit_loss_enterprise" model="ir.actions.client">
        <field name="name">Profit and Loss</field>
        <field name="tag">fs_enterprise.FinancialStatementsView</field>
        <field name="target">current</field>
        <field name="params">{'default_report_type': 'pl'}</field>
    </record>

    <!-- Menus under Accounting > Reporting -->
    <menuitem
        id="menu_balance_sheet_enterprise"
        name="Balance Sheet (Interactive)"
        parent="account.menu_finance_reports"
        action="action_balance_sheet_enterprise"
        sequence="25"
        groups="account.group_account_user"
    />

    <menuitem
        id="menu_profit_loss_enterprise"
        name="Profit and Loss (Interactive)"
        parent="account.menu_finance_reports"
        action="action_profit_loss_enterprise"
        sequence="26"
        groups="account.group_account_user"
    />

    <!-- Tax Return (VAT) client action -->
    <record id="action_tax_return_enterprise" model="ir.actions.client">
        <field name="name">Tax Return</field>
        <field name="tag">fs_enterprise.TaxReportView</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_tax_return_enterprise"
        name="Tax Return (Interactive)"
        parent="account.menu_finance_reports"
        action="action_tax_return_enterprise"
        sequence="27"
        groups="account.group_account_user"
    />

</odoo>
