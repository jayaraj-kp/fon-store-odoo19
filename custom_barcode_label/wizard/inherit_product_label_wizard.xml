<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the built-in product.label.wizard form to rename "Show MRP" → "Show Sales Price" -->
    <record id="view_product_label_wizard_inherit_custom" model="ir.ui.view">
        <field name="name">product.label.wizard.form.inherit.custom.barcode.label</field>
        <field name="model">product.label.wizard</field>
        <field name="inherit_id" ref="product_label_print.product_label_wizard_view_form"/>
        <field name="arch" type="xml">
            <field name="show_mrp" position="attributes">
                <attribute name="string">Show Sales Price</attribute>
            </field>
        </field>
    </record>
</odoo>