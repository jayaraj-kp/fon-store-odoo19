<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="view_account_list">
        <field name="name">account.account.list.inherit</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="arch" type="xml">
            <list position="inside">
                <!-- Fixed the name attribute here to match the ID above -->
                <button type="action"
                        name="%(account_reconcile_oca.account_account_reconcile_act_window)s"
                        string="Reconcile"
                        class="btn-secondary"
                        invisible="reconcile == False"/>
            </list>
        </field>
    </record>
</odoo>



