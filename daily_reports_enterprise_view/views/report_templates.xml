<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_daily_reports_document">

        <!-- Text-based Header (matching Partner Ledger style) -->
        <t t-set="company_vat" t-value="company_id.vat or ''"/>
        <t t-set="company_logo" t-value="company_id.logo"/>
        <table style="width:100%; border-collapse:collapse; margin:0 0 6px;">
            <tr>
                <td style="vertical-align:middle; text-align:left;">
                    <div style="font-size:16px; font-weight:bold; color:#111; letter-spacing:0.3px;">
                        <span t-esc="company_name"/>
                    </div>
                    <div style="font-size:10.5px; color:#777; margin-top:3px;">
                        VAT Number: <span style="font-weight:bold; color:#111;" t-esc="company_vat"/>
                    </div>
                    <div style="font-size:19px; font-weight:bold; color:#111; margin-top:7px; letter-spacing:0.5px;">
                        <span t-esc="report_title"/>
                    </div>
                </td>
                <td style="width:150px; vertical-align:middle; padding:0 0 0 16px; text-align:right;">
                    <img t-if="company_logo"
                         t-att-src="'data:image/png;base64,%s' % company_logo.decode() if isinstance(company_logo, bytes) else 'data:image/png;base64,%s' % company_logo"
                         style="max-width:110px; max-height:80px; object-fit:contain; display:block; margin:0 0 0 auto;"/>
                </td>
            </tr>
        </table>
        <div style="border-bottom:2px solid #111; margin:0 0 8px;"></div>

        <div style="text-align:center; font-size:12px; color:#555; margin:0 0 10px 0; padding:4px; background:#f5f5f5; border:1px solid #ddd;">
            <span t-esc="date_from"/> - <span t-esc="date_to"/>
        </div>

        <div class="article">
            <div class="page">
                <table class="table table-sm" style="width:100%; font-size:12px;">
                    <thead>
                        <tr style="background:#f5f5f5;">
                            <th style="text-align:left; padding:6px 8px;">Entry / Particulars</th>
                            <th style="text-align:left; padding:6px 8px;">Partner</th>
                            <th style="text-align:left; padding:6px 8px;">Journal</th>
                            <th style="text-align:left; padding:6px 8px;">Account</th>
                            <th style="text-align:left; padding:6px 8px;">Date</th>
                            <th style="text-align:left; padding:6px 8px;">Ref</th>
                            <th style="text-align:right; padding:6px 8px;">Debit</th>
                            <th style="text-align:right; padding:6px 8px;">Credit</th>
                            <th style="text-align:right; padding:6px 8px; width:130px;">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="total_line" t-value="lines[0] if lines and lines[0].get('line_type') == 'total' else False"/>
                        <t t-set="body_lines" t-value="lines[1:] if total_line else lines"/>

                        <!-- Total HEADER row at the TOP (label only, NO amounts) -->
                        <t t-if="total_line">
                            <tr style="font-weight:bold;background:#eeeeee;font-size:12px;">
                                <td style="padding:5px 8px;"><span t-esc="report_title"/></td>
                                <td style="padding:5px 8px;"/><td style="padding:5px 8px;"/>
                                <td style="padding:5px 8px;"/><td style="padding:5px 8px;"/>
                                <td style="padding:5px 8px;"/><td style="padding:5px 8px;"/>
                                <td style="padding:5px 8px;"/><td style="padding:5px 8px;"/>
                            </tr>
                        </t>

                        <!-- Render detail lines -->
                        <t t-call="daily_reports_enterprise_view.report_daily_reports_lines">
                            <t t-set="report_lines" t-value="body_lines"/>
                        </t>

                        <!-- Total row at the BOTTOM with amounts -->
                        <t t-if="total_line">
                            <tr style="font-weight:bold;background:#eeeeee;font-size:12px;border-top:2px solid #8b0000;">
                                <td style="padding:5px 8px;"><span t-esc="report_title"/></td>
                                <td style="padding:5px 8px;"/><td style="padding:5px 8px;"/>
                                <td style="padding:5px 8px;"/><td style="padding:5px 8px;"/>
                                <td style="padding:5px 8px;"/>
                                <td style="text-align:right; padding:5px 8px;">
                                    <span t-esc="'%.2f' % (total_line.get('debit') or 0.0)"/>
                                </td>
                                <td style="text-align:right; padding:5px 8px;">
                                    <span t-esc="'%.2f' % (total_line.get('credit') or 0.0)"/>
                                </td>
                                <td style="text-align:right; padding:5px 8px;">
                                    <span t-esc="'%.2f' % (total_line.get('balance') or 0.0)"/>
                                    <span t-esc="currency_symbol"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Native wkhtmltopdf footer -->
        <div class="footer">
            <div id="dr-bank-footer"
                 style="width:100%; padding-top:10px; border-top:2px solid #8b0000;
                        font-size:11px; color:#222; font-family:Arial,sans-serif; line-height:1.7;">

                <!-- Bank Accounts Section -->
                <div style="font-size:12px; font-weight:bold; color:#8b0000; margin-bottom:6px; text-transform:uppercase;">
                    Bank Accounts
                </div>
                <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
                    <tr>
                        <td style="width:50%; vertical-align:top; padding:0 14px 0 0; border-right:1px solid #bbb;">
                            <div style="font-size:12px; font-weight:bold; margin-bottom:2px;">
                                Sameer Sharaf Al Otaibi Trading Company
                            </div>
                            <div style="font-size:11px; color:#555;">ALRAJHI BANK</div>
                            <div>Account Number: <strong>123000010006080143917</strong></div>
                            <div>IBAN: <strong>SA7880000123608010143917</strong></div>
                        </td>
                        <td style="width:50%; vertical-align:top; padding:0 0 0 14px;">
                            <div style="font-size:12px; font-weight:bold; margin-bottom:2px;">
                                Sameer Sharaf Alateebi Company Commercial
                            </div>
                            <div style="font-size:11px; color:#555;">SNB - SAUDI NATIONAL BANK</div>
                            <div>Account Number: <strong>13200000678707</strong></div>
                            <div>IBAN: <strong>SA2110000013200000678707</strong></div>
                        </td>
                    </tr>
                </table>

                <!-- Branch Locations Section -->
                <div style="font-size:12px; font-weight:bold; color:#8b0000; margin-bottom:6px; text-transform:uppercase; border-top:1px solid #ccc; padding-top:8px;">
                    Branch Locations
                </div>
                <table style="width:100%; border-collapse:collapse;">
                    <tr>
                        <td style="width:33.33%; vertical-align:top; padding:4px 12px 4px 0; border-right:1px solid #ddd;">
                            <div style="font-size:11px; font-weight:bold; margin-bottom:2px;">Jeddah Al Fayha Branch:</div>
                            <div style="font-size:10px;">7655 Al Fayha Dist., Jeddah 22244-3108, Saudi Arabia</div>
                            <div style="font-size:10px;">Tel/Mobile: +966 571 313 243</div>
                            <div style="font-size:10px;">Email: ssaoe.jeddah@gmail.com</div>
                        </td>
                        <td style="width:33.33%; vertical-align:top; padding:4px 12px; border-right:1px solid #ddd;">
                            <div style="font-size:11px; font-weight:bold; margin-bottom:2px;">Jeddah Baladiya Branch:</div>
                            <div style="font-size:10px;">Sookul Anwar, Al Baladeah, Aziziyah, Jeddah 31303, Saudi Arabia</div>
                            <div style="font-size:10px;">Tel/Mobile: +966 536 122 833</div>
                            <div style="font-size:10px;">Email: ssaoe.jeddah@gmail.com</div>
                        </td>
                        <td style="width:33.33%; vertical-align:top; padding:4px 0 4px 12px;">
                            <div style="font-size:11px; font-weight:bold; margin-bottom:2px;">Dammam Branch:</div>
                            <div style="font-size:10px;">8515 Qutaibah bin Muslim St., Al Souq, Dammam 4525-32242, Saudi Arabia</div>
                            <div style="font-size:10px;">Tel/Mobile: +966 535 081 008</div>
                            <div style="font-size:10px;">Email: ssaoe.jeddah@gmail.com</div>
                        </td>
                    </tr>
                </table>
            </div>

            <script>
                (function () {
                    function hideUnlessLastPage() {
                        var qs = (document.location.search || '').replace(/^\?/, '');
                        var params = {};
                        qs.split('&amp;').forEach(function (pair) {
                            var kv = pair.split('=');
                            if (kv[0]) { params[kv[0]] = decodeURIComponent(kv[1] || ''); }
                        });
                        var page = parseInt(params.page, 10);
                        var topage = parseInt(params.topage, 10);
                        var el = document.getElementById('dr-bank-footer');
                        if (el &amp;&amp; page &amp;&amp; topage &amp;&amp; page !== topage) {
                            el.style.display = 'none';
                        }
                    }
                    if (document.readyState === 'complete') {
                        hideUnlessLastPage();
                    } else {
                        window.addEventListener('load', hideUnlessLastPage);
                    }
                })();
            </script>
        </div>
    </template>

    <template id="report_daily_reports_lines">
        <t t-foreach="report_lines" t-as="line">
            <tr t-att-style="line.get('style') in ('header', 'group') and 'font-weight:bold;background:#eeeeee;font-size:12px;' or 'font-size:11px;'">
                <td style="padding:5px 8px;">
                    <span t-if="line.get('line_type') == 'total'" t-esc="report_title"/>
                    <span t-else="" t-esc="line.get('name')"/>
                </td>
                <!-- Group / Opening rows: label only, NO amounts -->
                <t t-if="line.get('line_type') in ('group', 'opening')">
                    <td style="padding:5px 8px;"/><td style="padding:5px 8px;"/>
                    <td style="padding:5px 8px;"/><td style="padding:5px 8px;"/>
                    <td style="padding:5px 8px;"/><td style="padding:5px 8px;"/>
                    <td style="padding:5px 8px;"/><td style="padding:5px 8px;"/>
                </t>
                <!-- Detail / account lines: full data with amounts -->
                <t t-else="">
                    <td style="padding:5px 8px;"><span t-esc="line.get('partner_name')"/></td>
                    <td style="padding:5px 8px;"><span t-esc="line.get('journal')"/></td>
                    <td style="padding:5px 8px;"><span t-esc="line.get('account')"/></td>
                    <td style="padding:5px 8px;">
                        <span t-esc="line.get('invoice_date') and (line.get('invoice_date').split('-')[2] + '/' + line.get('invoice_date').split('-')[1] + '/' + line.get('invoice_date').split('-')[0]) or ''"/>
                    </td>
                    <td style="padding:5px 8px;"><span t-esc="line.get('ref')"/></td>
                    <td style="text-align:right; padding:5px 8px;">
                        <span t-esc="'%.2f' % (line.get('debit') or 0.0)"/>
                    </td>
                    <td style="text-align:right; padding:5px 8px;">
                        <span t-esc="'%.2f' % (line.get('credit') or 0.0)"/>
                    </td>
                    <td style="text-align:right; padding:5px 8px;">
                        <span t-esc="'%.2f' % (line.get('balance') or 0.0)"/>
                        <span t-esc="currency_symbol"/>
                    </td>
                </t>
            </tr>
            <t t-if="line.get('children')">
                <t t-call="daily_reports_enterprise_view.report_daily_reports_lines">
                    <t t-set="report_lines" t-value="line.get('children')"/>
                </t>
            </t>
        </t>
    </template>

    <template id="report_daily_reports_pdf">
        <t t-call="web.html_container">
            <t t-call="daily_reports_enterprise_view.report_daily_reports_document"/>
        </t>
    </template>

    <record id="paperformat_daily_reports" model="report.paperformat">
        <field name="name">Daily Reports</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">62</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">3</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_daily_reports_pdf" model="ir.actions.report">
        <field name="name">Daily Report</field>
        <field name="model">daily.reports.engine</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">daily_reports_enterprise_view.report_daily_reports_pdf</field>
        <field name="report_file">daily_reports_enterprise_view.report_daily_reports_pdf</field>
        <field name="print_report_name">'Daily Report'</field>
        <field name="paperformat_id" ref="paperformat_daily_reports"/>
    </record>

</odoo>
