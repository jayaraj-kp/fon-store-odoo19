<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Builds queued big XLSX exports. Also triggered right after queueing. -->
    <record id="ir_cron_gl_export_process" model="ir.cron">
        <field name="name">GL Enterprise: process queued exports</field>
        <field name="model_id" ref="model_gl_export_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_jobs()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Removes finished export files after a few days. -->
    <record id="ir_cron_gl_export_vacuum" model="ir.cron">
        <field name="name">GL Enterprise: delete old export files</field>
        <field name="model_id" ref="model_gl_export_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_vacuum_jobs()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>