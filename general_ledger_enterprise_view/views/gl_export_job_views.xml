<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gl_export_job_list" model="ir.ui.view">
        <field name="name">gl.export.job.list</field>
        <field name="model">gl.export.job</field>
        <field name="arch" type="xml">
            <list create="0" edit="0"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'failed'"
                  decoration-muted="state == 'queued'">
                <field name="create_date" string="Requested"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="row_estimate"/>
                <field name="state" widget="badge"/>
                <field name="date_done"/>
                <button name="action_download" type="object" string="Download"
                        icon="fa-download" invisible="state != 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_gl_export_job_form" model="ir.ui.view">
        <field name="name">gl.export.job.form</field>
        <field name="model">gl.export.job</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_download" type="object" string="Download"
                            class="btn-primary" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="queued,processing,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="company_id"/>
                            <field name="report_type"/>
                        </group>
                        <group>
                            <field name="row_estimate"/>
                            <field name="create_date"/>
                            <field name="date_done"/>
                            <field name="file_name"/>
                        </group>
                    </group>
                    <group invisible="state != 'failed'">
                        <field name="error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gl_export_job" model="ir.actions.act_window">
        <field name="name">Export Files</field>
        <field name="res_model">gl.export.job</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gl_export_job"
              name="Export Files"
              parent="menu_enterprise_reports"
              action="action_gl_export_job"
              sequence="20"
              groups="account.group_account_user"/>
</odoo>