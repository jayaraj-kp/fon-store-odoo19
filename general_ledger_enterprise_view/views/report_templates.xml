    <!-- ================================================================
         Enterprise PDF Stylesheet (inlined for cache-busting)
         ================================================================ -->
    <template id="enterprise_pdf_styles" inherit_id="web.basic_layout">
        <xpath expr="." position="inside">
            <style type="text/css">
/* 1. BASE TYPOGRAPHY - FIX v2: Arabic-capable fonts MUST be listed before DejaVu Sans.
   DejaVu Sans lacks Arabic contextual shaping (joined letterforms); when it's first,
   wkhtmltopdf's old WebKit font matcher grabs it for Arabic runs anyway, producing the
   garbled "Ø / Ù" mojibake. Also requires Noto Naskh/Sans Arabic to be installed as
   OS-level fonts on the server that runs wkhtmltopdf (CSS alone won't pull them in). */
body {
    font-family: 'Noto Naskh Arabic','Noto Sans Arabic','DejaVu Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                 "Helvetica Neue", Arial, sans-serif !important;
    font-size: 14px !important;
    color: #212529 !important;
    unicode-bidi: plaintext !important;
}
.amount { font-family: 'DejaVu Sans', monospace !important; unicode-bidi: isolate !important; }
.act_as_cell, td, th { unicode-bidi: plaintext !important; }

.act_as_cell a {
    color: inherit !important;
    text-decoration: none !important;
}

/* 2. REMOVE BORDERS/BACKGROUNDS FROM TABLE WRAPPER ELEMENTS */
.act_as_table, .act_as_thead, .act_as_row, .act_as_cell {
    border: none !important;
    background: transparent !important;
    background-color: transparent !important;
}

/* 3. COLUMN HEADER ROWS (labels) */
.act_as_row.labels {
    border-bottom: 2px solid #495057 !important;
    background: transparent !important;
    font-weight: bold !important;
    margin-bottom: 4px !important;
}
.act_as_row.labels .act_as_cell {
    background: transparent !important;
    font-weight: bold !important;
    padding: 5px 6px !important;
    font-size: 13px !important;
}

/* 4. DATA ROWS */
.act_as_row:not(.labels) .act_as_cell {
    padding: 5px 6px !important;
    vertical-align: middle !important;
    background: transparent !important;
    font-size: 14px !important;
    border-bottom: 1px solid #e3e3e3 !important;
}

/* 5. ACCOUNT / PARTNER SUMMARY ROW */
.oca-gl-pdf-accrow {
    margin-top: 10px !important;
}
.oca-gl-pdf-accrow .act_as_cell {
    font-weight: bold !important;
    background: transparent !important;
    color: #212529 !important;
    padding-top: 7px !important;
    padding-bottom: 7px !important;
}

/* 6. MOVE LINE ROWS */
.oca-gl-pdf-moveline .act_as_cell {
    color: #212529 !important;
    vertical-align: top !important;
}

/* 7. RIGHT-ALIGN AMOUNTS */
.act_as_cell.amount,
.act_as_cell.right,
.act_as_cell[style*="text-align: right"],
.act_as_cell[style*="text-align:right"] {
    text-align: right !important;
    font-variant-numeric: tabular-nums !important;
}

/* 8. LEFT-ALIGN */
.act_as_cell.left {
    text-align: left !important;
}

/* 9. COMPANY HEADER */
.oca-gl-pdf-companyheader { display: table; width: 100%; margin-bottom: 4px; }
.oca-gl-pdf-companyleft { display: table-cell; width: 65%; vertical-align: top; text-align: left; }
.oca-gl-pdf-companyright { display: table-cell; width: 35%; vertical-align: top; text-align: right; }
.oca-gl-pdf-logo { max-height: 55px; max-width: 180px; display: block; margin-bottom: 4px; }
.oca-gl-pdf-companyname { font-weight: 700 !important; font-size: 14px !important; color: #212529 !important; }
.oca-gl-pdf-companycountry { font-size: 12px !important; color: #6c757d !important; }
.oca-gl-pdf-companyvat { font-size: 12px !important; color: #495057 !important; }
.oca-gl-pdf-title { font-size: 18px !important; font-weight: 700 !important; color: #212529 !important; margin: 0 !important; }

/* 10. PERIOD BAND */
.oca-gl-pdf-period {
    display: block;
    width: 100%;
    text-align: center;
    background-color: #f0f0f0;
    color: #343a40;
    font-weight: 600;
    font-size: 13px;
    padding: 8px 0;
    margin: 12px 0 6px 0;
    border-radius: 3px;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
}

/* 11. WRAP TEXT */
.oca_gl_pdf_entry,
.oca_gl_pdf_truncate {
    white-space: normal !important;
    overflow: visible !important;
    text-overflow: clip !important;
    max-width: 100%;
    display: block;
    line-height: 1.35 !important;
    word-break: break-word !important;
}

/* 12. ZERO-AMOUNT DIMMING */
.oca-gl-pdf-zero {
    color: #adb5bd !important;
}

/* 13. GLOBAL COLUMN HEADER */
.oca-gl-pdf-header .act_as_cell { font-weight: bold !important; }

/* 14. GRAND TOTAL ROW */
.oca-gl-pdf-grandtotal .act_as_cell { font-weight: bold !important; font-size: 14px !important; }

/* 15. TRIAL BALANCE - CENTERED HEADER */
.oca-tb-pdf-header-block {
    width: 100%;
    margin-bottom: 4px;
}
.oca-tb-pdf-companycenter {
    text-align: center;
}
.oca-tb-pdf-companycenter .oca-gl-pdf-logo {
    margin: 0 auto 4px auto !important;
}
.oca-tb-pdf-companycenter .oca-gl-pdf-companyname,
.oca-tb-pdf-companycenter .oca-gl-pdf-companycountry,
.oca-tb-pdf-companycenter .oca-gl-pdf-companyvat {
    text-align: center !important;
}
.oca-tb-pdf-title-center {
    text-align: center !important;
    margin-top: 6px !important;
}
.oca-tb-pdf-period-left {
    text-align: left;
    font-size: 13px;
    font-weight: 600;
    color: #343a40;
    margin-top: 8px;
}

/* 16. TRIAL BALANCE - TWO-ROW HEADER TABLE */
.oca-tb-pdf-header-table {
    border-collapse: collapse;
    width: 100%;
    margin-top: 4px;
}
.oca-tb-pdf-header-table th {
    font-size: 14px !important;
    font-weight: bold !important;
    padding: 6px 6px !important;
    border-bottom: 2px solid #495057 !important;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
}
.oca-tb-pdf-period-cell {
    background-color: #f0f0f0 !important;
    border-radius: 3px;
}

/* 17. TRIAL BALANCE - LARGER DATA ROWS */
div.oca-tb-pdf-lines div.act_as_row div.act_as_cell {
    font-size: 16px !important;
    padding: 6px 6px !important;
}
div.oca-tb-pdf-lines div.oca-gl-pdf-accrow div.act_as_cell {
    font-size: 16px !important;
    font-weight: bold !important;
}
div.oca-tb-pdf-lines div.oca-gl-pdf-partner-row div.act_as_cell {
    font-size: 14px !important;
    font-style: italic !important;
    font-weight: 600 !important;
}
div.oca-tb-pdf-grandtotal div.act_as_cell {
    font-size: 16px !important;
    font-weight: bold !important;
}

/* 18. PAGE BREAKS */
.page_break { page-break-inside: avoid; margin-bottom: 2px !important; }
            </style>
        </xpath>
    </template>

</odoo>