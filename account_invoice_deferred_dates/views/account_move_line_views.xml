<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--  Extend Invoice Line (account.move.line) list inside invoice  -->
    <!-- ============================================================ -->

    <record id="view_move_form_deferred_dates" model="ir.ui.view">
        <field name="name">account.move.form.deferred.dates</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Add Start Date and End Date as optional columns after Taxes column -->
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='tax_ids']"
                   position="after">
                <field name="deferred_start_date"
                       string="Start Date"
                       optional="show"
                       widget="date"/>
                <field name="deferred_end_date"
                       string="End Date"
                       optional="show"
                       widget="date"/>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Extend Journal Items tab (account.move.line) inside invoice  -->
    <!-- ============================================================ -->

    <record id="view_move_form_journal_items_deferred_dates" model="ir.ui.view">
        <field name="name">account.move.form.journal.items.deferred.dates</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Add Start Date and End Date in Journal Items tab -->
            <xpath expr="//field[@name='line_ids']/list//field[@name='tax_ids']"
                   position="after">
                <field name="deferred_start_date"
                       string="Start Date"
                       optional="show"
                       widget="date"/>
                <field name="deferred_end_date"
                       string="End Date"
                       optional="show"
                       widget="date"/>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Standalone account.move.line list view (Journal Items menu)  -->
    <!-- ============================================================ -->

    <record id="view_move_line_list_deferred_dates" model="ir.ui.view">
        <field name="name">account.move.line.list.deferred.dates</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//list" position="inside">
                <field name="deferred_start_date"
                       string="Deferred Start Date"
                       optional="show"
                       widget="date"/>
                <field name="deferred_end_date"
                       string="Deferred End Date"
                       optional="show"
                       widget="date"/>
            </xpath>

        </field>
    </record>

</odoo>
