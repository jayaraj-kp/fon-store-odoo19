<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--  Invoice Lines tab — add Start Date, End Date, Deferred Acct  -->
    <!-- ============================================================ -->

    <record id="view_move_form_deferred_dates" model="ir.ui.view">
        <field name="name">account.move.form.deferred.dates</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Add three columns after Taxes in Invoice Lines -->
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='tax_ids']"
                   position="after">
                <field name="deferred_start_date"
                       string="Start Date"
                       optional="show"
                       widget="date"/>
                <field name="deferred_end_date"
                       string="End Date"
                       optional="show"
                       widget="date"/>
                <field name="deferred_account_id"
                       string="Deferred Account"
                       optional="show"
                       options="{'no_create': True}"/>
            </xpath>

            <!-- Same three columns in Journal Items tab -->
            <xpath expr="//field[@name='line_ids']/list//field[@name='tax_ids']"
                   position="after">
                <field name="deferred_start_date"
                       string="Start Date"
                       optional="show"
                       widget="date"/>
                <field name="deferred_end_date"
                       string="End Date"
                       optional="show"
                       widget="date"/>
                <field name="deferred_account_id"
                       string="Deferred Account"
                       optional="show"
                       options="{'no_create': True}"/>
            </xpath>

        </field>
    </record>

</odoo>
