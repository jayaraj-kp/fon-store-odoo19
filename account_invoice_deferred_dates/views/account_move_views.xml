<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--  Smart button on the bill form — shows Deferred Entries count -->
    <!-- ============================================================ -->

    <record id="view_move_form_deferred_button" model="ir.ui.view">
        <field name="name">account.move.form.deferred.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Inject smart button into the button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_deferred_entries"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar-check-o"
                        attrs="{'invisible': [('deferred_move_count', '=', 0)]}">
                    <field name="deferred_move_count"
                           widget="statinfo"
                           string="Deferred Entries"/>
                </button>
            </xpath>

            <!-- Hidden field needed for the attrs condition -->
            <xpath expr="//field[@name='name']" position="before">
                <field name="deferred_move_ids" invisible="1"/>
            </xpath>

        </field>
    </record>

</odoo>
