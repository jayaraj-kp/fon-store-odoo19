<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        ══════════════════════════════════════════════════════════════════
        Odoo 19 renamed the inventory overview kanban view.

        The correct XML ID in Odoo 17+ is:
            stock.stock_picking_type_kanban

        (The old id "stock.view_picking_type_kanban" was used in Odoo ≤16)

        If this still fails on your version, run this in Odoo shell to find it:
            env['ir.ui.view'].search([
                ('model','=','stock.picking.type'),
                ('type','=','kanban')
            ]).mapped(lambda v: (v.xml_id, v.name))
        ══════════════════════════════════════════════════════════════════
    -->

    <record id="view_picking_type_kanban_wh_stats" model="ir.ui.view">
        <field name="name">stock.picking.type.kanban.wh.send.accept</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.stock_picking_type_kanban"/>
        <field name="arch" type="xml">

            <!--
                Inject To Send / To Accept badges below the existing stats block.
                wh_to_send_count and wh_to_accept_count are computed fields
                on stock.picking.type defined in models/stock_warehouse.py.
            -->
            <xpath expr="//div[hasclass('o_kanban_primary_bottom')]" position="after">
                <div class="o_wh_send_accept_row d-flex gap-2 flex-wrap px-2 pb-2 mt-1">

                    <t t-if="record.wh_to_send_count.raw_value and record.wh_to_send_count.raw_value &gt; 0">
                        <a
                            class="o_wh_badge o_wh_badge_send"
                            t-att-data-warehouse-id="record.warehouse_id.raw_value"
                            t-att-data-direction="'send'"
                        >
                            To Send
                            <span class="o_wh_badge_count">
                                <t t-esc="record.wh_to_send_count.raw_value"/>
                            </span>
                        </a>
                    </t>

                    <t t-if="record.wh_to_accept_count.raw_value and record.wh_to_accept_count.raw_value &gt; 0">
                        <a
                            class="o_wh_badge o_wh_badge_accept"
                            t-att-data-warehouse-id="record.warehouse_id.raw_value"
                            t-att-data-direction="'accept'"
                        >
                            To Accept
                            <span class="o_wh_badge_count">
                                <t t-esc="record.wh_to_accept_count.raw_value"/>
                            </span>
                        </a>
                    </t>

                </div>
            </xpath>

        </field>
    </record>

</odoo>
