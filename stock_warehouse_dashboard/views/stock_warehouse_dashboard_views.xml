<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════
         1. Kanban card badges — only on Internal Transfer cards

         Odoo 19 kanban structure for stock.picking.type:
           <kanban>
             <field name="..."/>          ← data fields
             <templates>
               <t t-name="card">
                 <field name="..."/>      ← rendered fields inside card
                 ...
               </t>
             </templates>
           </kanban>

         XPath notes:
           - We inject our fields at the <kanban> level (before <templates>)
             so they are fetched by the view but not rendered inline.
           - We inject our badge HTML inside the card template using
             position="after" on the last <field> inside the card,
             which is safer than position="inside" on the <t> root.
         ══════════════════════════════════════════════════════════════ -->

    <record id="view_picking_type_kanban_wh_send_accept" model="ir.ui.view">
        <field name="name">stock.picking.type.kanban.wh.send.accept</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.stock_picking_type_kanban"/>
        <field name="arch" type="xml">

            <!-- Inject data fields at kanban root level so they are fetched.
                 'code' may already be there; IF NOT EXISTS guards are in attrs. -->
            <kanban position="attributes">
                <!-- no-op attribute trick: just ensures the kanban node is found -->
            </kanban>

            <!-- Add our fields right before </kanban> closes, after all existing fields -->
            <xpath expr="//kanban/field[last()]" position="after">
                <field name="wh_to_send_count"/>
                <field name="wh_to_accept_count"/>
                <field name="code"/>
                <field name="warehouse_id"/>
            </xpath>

            <!-- Append badge row at the bottom of the card body.
                 We target the last direct <field> inside the card template.
                 If that xpath breaks on a future Odoo update, the fallback
                 is position="inside" on //t[@t-name='card'] which still works
                 but appends at the very end. -->
            <xpath expr="//t[@t-name='card']" position="inside">
                <t t-if="record.code.raw_value === 'internal'">
                    <div class="o_wh_send_accept_row mt4">
                        <t t-if="record.wh_to_send_count.raw_value > 0">
                            <a class="o_wh_badge o_wh_badge_send"
                               t-att-data-picking-type-id="record.id.raw_value"
                               data-direction="send"
                               title="Open transfers waiting to be sent">
                                <i class="fa fa-paper-plane me-1"/>
                                To Send
                                <span class="o_wh_badge_count">
                                    <t t-esc="record.wh_to_send_count.raw_value"/>
                                </span>
                            </a>
                        </t>
                        <t t-if="record.wh_to_accept_count.raw_value > 0">
                            <a class="o_wh_badge o_wh_badge_accept"
                               t-att-data-picking-type-id="record.id.raw_value"
                               data-direction="accept"
                               title="Open transfers waiting to be accepted">
                                <i class="fa fa-check-circle me-1"/>
                                To Accept
                                <span class="o_wh_badge_count">
                                    <t t-esc="record.wh_to_accept_count.raw_value"/>
                                </span>
                            </a>
                        </t>
                    </div>
                </t>
            </xpath>

        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         2. Transfer list view — Send/Accept label column
         ══════════════════════════════════════════════════════════════ -->

    <record id="view_picking_list_wh_send_accept" model="ir.ui.view">
        <field name="name">stock.picking.list.wh.send.accept</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="send_accept_label"
                       string="Send/Accept"
                       optional="show"
                       widget="badge"
                       decoration-success="send_accept_label == 'To Send'"
                       decoration-info="send_accept_label == 'To Accept'"/>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         3. Transfer form view — Send / Accept buttons + smart buttons
            • [Send]     shown when wh_send_state == 'pending'
            • [Accept]   shown when wh_send_state == 'sent'
            • [Validate] hidden for cross-WH transfers (enforce flow)
            • Smart buttons link to the auto-created journal entries
         ══════════════════════════════════════════════════════════════ -->

    <record id="view_picking_form_wh_send_accept" model="ir.ui.view">
        <field name="name">stock.picking.form.wh.send.accept</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- Invisible control fields loaded into the form -->
            <xpath expr="//sheet" position="before">
                <field name="wh_show_send_btn"          invisible="1"/>
                <field name="wh_show_accept_btn"        invisible="1"/>
                <field name="wh_hide_validate_btn"      invisible="1"/>
                <field name="wh_is_cross_transfer"      invisible="1"/>
                <field name="wh_send_state"             invisible="1"/>
                <field name="wh_send_journal_entry_id"  invisible="1"/>
                <field name="wh_accept_journal_entry_id" invisible="1"/>
            </xpath>

            <!-- [Send] and [Accept] inserted BEFORE the standard Validate button -->
            <xpath expr="//header/button[@name='button_validate']" position="before">

                <button name="action_wh_send"
                        string="Send"
                        type="object"
                        class="btn-primary o_wh_btn_send"
                        icon="fa-paper-plane"
                        invisible="not wh_show_send_btn"
                        confirm="Mark this transfer as sent? The destination warehouse will be able to accept it. A journal entry (Dr Stock Transfer Out / Cr Stock Valuation) will be created automatically."/>

                <button name="action_wh_accept"
                        string="Accept"
                        type="object"
                        class="btn-success o_wh_btn_accept"
                        icon="fa-check-circle"
                        invisible="not wh_show_accept_btn"
                        confirm="Accept and validate this transfer? Stock will be moved and a journal entry (Dr Stock Valuation / Cr Stock Transfer In) will be created automatically."/>

            </xpath>

            <!-- Hide the standard Validate buttons for cross-WH transfers -->
            <xpath expr="//header/button[@name='button_validate' and contains(@class, 'oe_highlight')]" position="attributes">
                <attribute name="invisible">state in ('draft', 'confirmed', 'done', 'cancel') or wh_hide_validate_btn</attribute>
            </xpath>
            <xpath expr="//header/button[@name='button_validate' and contains(@class, 'o_btn_validate')]" position="attributes">
                <attribute name="invisible">state in ('waiting', 'assigned', 'done', 'cancel') or wh_hide_validate_btn</attribute>
            </xpath>

            <!-- Smart buttons — link to the auto-created journal entries -->
            <xpath expr="//div[@name='button_box']" position="inside">

                <button name="action_view_wh_send_journal_entry"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        invisible="not wh_send_journal_entry_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Send Entry</span>
                    </div>
                </button>

                <button name="action_view_wh_accept_journal_entry"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-check-square-o"
                        invisible="not wh_accept_journal_entry_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Accept Entry</span>
                    </div>
                </button>

            </xpath>

        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         4. Warehouse form view — Accounting configuration tab
            Adds 5 new fields:
              • Stock Transfer Out Account
              • Stock Valuation Account
              • Stock Transfer In Account
              • Stock Transfer Journal
              • Analytic Account
         ══════════════════════════════════════════════════════════════ -->

    <record id="view_warehouse_form_wh_accounting" model="ir.ui.view">
        <field name="name">stock.warehouse.form.wh.accounting</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">

            <!-- Append a new Accounting tab after the last existing page -->
            <xpath expr="//notebook" position="inside">
                <page string="Accounting" name="wh_accounting">
                    <group string="Cross-Warehouse Transfer Accounts"
                           col="2"
                           help="These accounts are used when journal entries are auto-created during the Send / Accept workflow for cross-warehouse internal transfers.">
                        <group string="Send Entry (when sender clicks [Send])">
                            <field name="wh_stock_transfer_out_account_id"
                                   options="{'no_create': True}"/>
                            <field name="wh_stock_valuation_account_id"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="Accept Entry (when receiver clicks [Accept])">
                            <field name="wh_stock_transfer_in_account_id"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Journal &amp; Analytic" col="2">
                        <field name="wh_stock_journal_id"
                               options="{'no_create': True}"
                               help="Journal to post the Send and Accept entries. Leave empty to auto-select the first General journal."/>
                        <field name="wh_analytic_account_id"
                               options="{'no_create': True}"
                               help="Applied as analytic on the Stock Valuation debit line of the Accept journal entry."/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>Journal Entry Flow:</strong><br/>
                        <b>On [Send]:</b>
                        &amp;nbsp;&amp;nbsp;Dr <em>Stock Transfer Out</em>
                        &amp;nbsp;/&amp;nbsp;
                        Cr <em>Stock Valuation</em><br/>
                        <b>On [Accept]:</b>
                        &amp;nbsp;Dr <em>Stock Valuation</em> <i>(with WH Analytic)</i>
                        &amp;nbsp;/&amp;nbsp;
                        Cr <em>Stock Transfer In</em>
                    </div>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
