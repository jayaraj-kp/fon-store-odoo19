<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="stock_warehouse_dashboard.SendAcceptCard" owl="1">
        <div class="o_wh_send_accept_card">
            <t t-if="state.loading">
                <span class="text-muted small">Loading…</span>
            </t>
            <t t-else="">
                <div class="o_wh_send_accept_badges d-flex gap-2 flex-wrap">
                    <t t-if="state.toSend > 0">
                        <button
                            class="btn btn-sm o_wh_badge_send"
                            t-on-click="onClickToSend"
                            t-attf-title="#{state.toSend} outgoing transfers ready to send from #{props.warehouseName}"
                        >
                            To Send <span class="badge ms-1"><t t-esc="state.toSend"/></span>
                        </button>
                    </t>
                    <t t-if="state.toAccept > 0">
                        <button
                            class="btn btn-sm o_wh_badge_accept"
                            t-on-click="onClickToAccept"
                            t-attf-title="#{state.toAccept} incoming transfers arriving at #{props.warehouseName}"
                        >
                            To Accept <span class="badge ms-1"><t t-esc="state.toAccept"/></span>
                        </button>
                    </t>
                    <t t-if="state.toSend === 0 and state.toAccept === 0">
                        <!-- nothing to show, render empty -->
                    </t>
                </div>
            </t>
        </div>
    </t>

</templates>
