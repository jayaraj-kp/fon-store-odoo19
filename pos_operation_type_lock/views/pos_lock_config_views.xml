<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View for Lock Configuration -->
    <record id="view_pos_lock_config_form" model="ir.ui.view">
        <field name="name">pos.operation.type.lock.config.form</field>
        <field name="model">pos.operation.type.lock.config</field>
        <field name="arch" type="xml">
            <form string="POS Operation Type Lock Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Lock Settings">
                            <field name="is_locked" widget="boolean_toggle"/>
                            <field name="lock_password" password="True"
                                   placeholder="Enter a secure password..."
                                   help="This password will be required to change the Operation Type in POS Settings"/>
                        </group>
                        <group string="Instructions">
                            <div class="alert alert-info" role="alert">
                                <strong>How it works:</strong>
                                <ul>
                                    <li>When <b>Lock is enabled</b>, the Operation Type field in POS Settings will be protected.</li>
                                    <li>Any user trying to change it will be prompted for this password.</li>
                                    <li>Only users who know this password can change the Operation Type.</li>
                                    <li>Only System Administrators can change this password.</li>
                                </ul>
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_pos_lock_config_tree" model="ir.ui.view">
        <field name="name">pos.operation.type.lock.config.tree</field>
        <field name="model">pos.operation.type.lock.config</field>
        <field name="arch" type="xml">
            <tree string="POS Lock Configuration">
                <field name="name"/>
                <field name="is_locked"/>
            </tree>
        </field>
    </record>

    <!-- Menu Action -->
    <record id="action_pos_lock_config" model="ir.actions.act_window">
        <field name="name">POS Operation Type Lock</field>
        <field name="res_model">pos.operation.type.lock.config</field>
        <field name="view_mode">form,tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure POS Operation Type Lock
            </p>
        </field>
    </record>

    <!-- Menu Item under Point of Sale > Configuration -->
    <menuitem
        id="menu_pos_lock_config"
        name="Operation Type Lock"
        parent="point_of_sale.menu_point_config"
        action="action_pos_lock_config"
        groups="base.group_system"
        sequence="99"/>

</odoo>
