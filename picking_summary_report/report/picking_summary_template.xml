<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="picking_summary_template">
    <t t-call="web.html_container">
        <t t-call="web.internal_layout">
            <div class="page">

                <!-- ── HEADER ──────────────────────────────────────── -->
                <div style="margin-bottom: 16px;">
                    <h2 style="margin: 0 0 4px 0; font-size: 20px; font-weight: 700; color: #1a1a2e;">
                        Picking Summary
                    </h2>
                    <p style="margin: 0; font-size: 11px; color: #555;">
                        <strong>References:</strong>
                        <t t-esc="picking_refs"/>
                    </p>
                    <p style="margin: 2px 0 0 0; font-size: 11px; color: #555;">
                        <strong>Total Lines:</strong>
                        <t t-esc="total_lines"/>
                    </p>
                </div>

                <!-- ── SUMMARY TABLE ───────────────────────────────── -->
                <t t-foreach="summary_lines" t-as="line">

                    <table style="width: 100%; border-collapse: collapse; font-size: 11px; margin-bottom: 0;">
                        <thead>

                            <!-- ROW 1: fixed column headers + "Destination" spanning all dest sub-columns -->
                            <tr style="background-color: #ffffff; color: #1a1a2e; border-bottom: 2px solid #1a1a2e;">
                                <th rowspan="2"
                                    style="padding: 7px 8px; text-align: center; width: 5%;
                                           border: 1px solid #ccc; vertical-align: middle;
                                           font-weight: 700;">
                                    Sl No.
                                </th>
                                <th rowspan="2"
                                    style="padding: 7px 8px; text-align: left; width: 16%;
                                           border: 1px solid #ccc; vertical-align: middle;
                                           font-weight: 700;">
                                    Category
                                </th>
                                <th rowspan="2"
                                    style="padding: 7px 8px; text-align: left; width: 15%;
                                           border: 1px solid #ccc; vertical-align: middle;
                                           font-weight: 700;">
                                    Location
                                </th>
                                <th rowspan="2"
                                    style="padding: 7px 8px; text-align: left; width: 22%;
                                           border: 1px solid #ccc; vertical-align: middle;
                                           font-weight: 700;">
                                    Product
                                </th>
                                <th rowspan="2"
                                    style="padding: 7px 8px; text-align: center; width: 6%;
                                           border: 1px solid #ccc; vertical-align: middle;
                                           font-weight: 700;">
                                    UoM
                                </th>
                                <!-- "Destination" main heading spanning all destination columns -->
                                <t t-set="dest_count" t-value="len(line['destinations'])"/>
                                <th t-att-colspan="dest_count"
                                    style="padding: 7px 8px; text-align: center;
                                           border: 1px solid #ccc;
                                           font-weight: 700; color: #1a1a2e;
                                           border-bottom: 1px solid #ccc;">
                                    Destination
                                </th>
                            </tr>

                            <!-- ROW 2: sub-headings — each destination name + picking ref -->
                            <tr style="background-color: #f5f5f5; color: #1a1a2e;">
                                <t t-foreach="line['destinations']" t-as="dest">
                                    <th style="padding: 6px 8px; text-align: center;
                                               border: 1px solid #ccc;
                                               font-size: 10px; font-weight: 700;">
                                        <t t-esc="dest['destination']"/>
                                        <br/>
                                        <span style="font-size: 9px; font-weight: 400; color: #666;">
                                            <t t-esc="dest['picking_ref']"/>
                                        </span>
                                    </th>
                                </t>
                            </tr>

                        </thead>

                        <!-- Data row -->
                        <tbody>
                            <tr t-att-style="'background-color: %s;' % ('#fafafa' if line_index % 2 == 0 else '#ffffff')">
                                <td style="padding: 6px 8px; text-align: center; border: 1px solid #ddd; color: #333;">
                                    <t t-esc="line['sl_no']"/>
                                </td>
                                <td style="padding: 6px 8px; border: 1px solid #ddd; color: #333;">
                                    <t t-esc="line['category']"/>
                                </td>
                                <td style="padding: 6px 8px; border: 1px solid #ddd; color: #333;">
                                    <t t-esc="line['source_location']"/>
                                </td>
                                <td style="padding: 6px 8px; border: 1px solid #ddd; font-weight: 600; color: #1a1a2e;">
                                    <t t-esc="line['product']"/>
                                </td>
                                <td style="padding: 6px 8px; text-align: center; border: 1px solid #ddd; color: #555;">
                                    <t t-esc="line['uom']"/>
                                </td>
                                <t t-foreach="line['destinations']" t-as="dest">
                                    <td style="padding: 6px 8px; text-align: center; border: 1px solid #ddd; color: #333; font-weight: 600;">
                                        <t t-esc="dest['qty']"/>
                                    </td>
                                </t>
                            </tr>
                        </tbody>

                    </table>

                    <div style="height: 8px;"></div>

                </t>

                <!-- Empty state -->
                <t t-if="not summary_lines">
                    <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                        <tbody>
                            <tr>
                                <td style="padding: 20px; text-align: center; color: #999; border: 1px solid #ddd;">
                                    No transfer lines found.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </t>

                <!-- ── FOOTER TOTALS ──────────────────────────────── -->
                <table style="width: 100%; border-collapse: collapse; font-size: 11px; margin-top: 8px;">
                    <tfoot>
                        <tr style="background-color: #ffffff; color: #1a1a2e;">
                            <td style="padding: 7px 8px; font-weight: 700; border: 1px solid #ccc; text-align: right;">
                                Total Product Lines:
                            </td>
                            <td style="padding: 7px 8px; font-weight: 700; text-align: center; border: 1px solid #ccc; width: 60px;">
                                <t t-esc="total_lines"/>
                            </td>
                        </tr>
                    </tfoot>
                </table>

                <!-- ── FOOTER NOTE ─────────────────────────────────── -->
                <div style="margin-top: 24px; font-size: 10px; color: #888; border-top: 1px solid #eee; padding-top: 8px;">
                    Generated automatically by FON-STORE replenishment system.
                </div>

            </div>
        </t>
    </t>
</template>
</odoo>


