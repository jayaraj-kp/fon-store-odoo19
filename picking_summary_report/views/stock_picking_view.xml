<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Picking Summary to the Print menu on the picking form -->
    <record id="view_picking_summary_print_button" model="ir.ui.view">
        <field name="name">stock.picking.summary.print.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button
                    name="%(picking_summary_report.action_picking_summary_report)d"
                    string="Picking Summary"
                    type="action"
                    class="btn-secondary"
                    groups="stock.group_stock_user"
                />
            </xpath>
        </field>
    </record>

</odoo>
